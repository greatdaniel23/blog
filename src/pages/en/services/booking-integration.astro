---
import SwissLayout from "../../../components/SwissLayout.astro";
import Icon from "../../../components/Icon.astro";

export const prerender = true;

const serviceLD = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Booking Engine Integration — Install & Manage for Bali Villas and Hotels",
  "provider": {
    "@type": "Organization",
    "name": "Alpha Digital Agency",
    "url": "https://alphadigitalagency.id"
  },
  "author": {
    "@type": "Person",
    "name": "Daniel Santoso",
    "url": "https://alphadigitalagency.id/daniel-santoso/#person"
  },
  "areaServed": "Bali, Indonesia",
  "description": "We install and manage booking engines for Bali hospitality properties — any platform, no vendor lock-in, no additional license fees. You stay in control.",
  "serviceType": "Booking Engine Integration",
  "url": "https://alphadigitalagency.id/en/services/booking-integration"
};

const faqItems = [
  {
    q: "Which booking engine platforms do you support?",
    a: "We are platform-agnostic: we integrate tracking on Cloudbeds, SiteMinder, Little Hotelier, STAAH for hotels, or deploy our proprietary standalone booking engine for villas with no monthly license fees."
  },
  {
    q: "Do I need to replace my existing booking engine?",
    a: "Not necessarily. If your current system works but is not yet connected to your Google Ads and Analytics reports — we can integrate without replacing the platform. If there are fundamental issues, we will discuss replacement options."
  },
  {
    q: "What does 'no vendor lock-in' mean?",
    a: "You can switch booking engines at any time without losing historical reservation data or starting from scratch. Your contract is with Alpha Digital as the implementer — not with any single booking engine platform."
  },
  {
    q: "Can reservation data flow directly into Google Ads reports?",
    a: "Yes, this is one of the key benefits. We integrate booking confirmations as conversions in Google Ads — so you can see exactly how much revenue is generated from each keyword and campaign."
  },
  {
    q: "How long does the booking engine integration process take?",
    a: "It depends on the complexity of your existing system. A standard integration (one property, one platform) typically takes 3–6 weeks including testing. Multi-property or complex PMS integrations can take longer."
  }
];

const faqLD = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const breadcrumbLD = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alphadigitalagency.id/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://alphadigitalagency.id/services/" },
    { "@type": "ListItem", "position": 3, "name": "Booking Integration", "item": "https://alphadigitalagency.id/en/services/booking-integration" }
  ]
};
---

<SwissLayout
  title="Booking Engine Integration Bali | Alpha Digital"
  description="Booking engine integration for Bali hotels and villas. We connect direct reservations, Google Ads tracking, and guest data without vendor lock-in."
  currentPage="services"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceLD)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLD)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />
  </Fragment>

  <!-- Hero -->
  <section class="max-w-4xl mx-auto mb-12 px-6 md:px-12 text-center">
    <p class="text-xs font-mono uppercase tracking-widest text-primary mb-4">Tier 4 — Booking Engine Integration</p>
    <h1
      class="font-display font-extrabold text-charcoal dark:text-white leading-display tracking-tightest text-[2rem] sm:text-[3rem] md:text-[4rem] lg:text-[5rem] mb-6"
    >
      Yours. Not the Vendor<span class="text-primary">.</span>
    </h1>
    <p class="text-slate-600 dark:text-slate-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
      We install and manage booking engines — any platform, no vendor lock-in, no additional license fees. You stay in control.
    </p>
    <div class="mt-8">
      <a
        href="mailto:daniel@alphadigitalagency.id"
        class="btn-swiss inline-flex items-center gap-2 px-8 py-4 bg-primary text-white border-2 border-charcoal shadow-premium font-bold text-sm uppercase tracking-widest"
      >
        <Icon name="mail" class="" />
        Request a Proposal
      </a>
    </div>
  </section>

  <!-- Outcome statement -->
  <section class="max-w-4xl mx-auto mb-8 px-6 md:px-12">
    <div class="bg-primary/5 dark:bg-primary/10 border-l-4 border-primary p-6 md:p-8">
      <p class="text-slate-700 dark:text-slate-300 text-base md:text-lg leading-relaxed">
        Our booking engine can be used on any property — not tied to any platform, no monthly license fees, and you retain full control over your reservation data.
      </p>
    </div>
  </section>

  <!-- OTA Shift thesis -- why booking engine matters -->
  <section class="max-w-4xl mx-auto mb-8 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12">
      <h2 class="font-display font-bold text-xl md:text-2xl text-charcoal dark:text-white mb-4">
        Why Platform-Agnostic Matters
      </h2>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
        Every booking via an OTA means 15–25% commission leaves your villa room revenue. The goal of the booking engine integration we install is not merely to "have a book button" — it is to shift 15–30% of reservations from OTAs to direct bookings within the first 90 days. Every shift is a permanent margin recovery: commission that previously left the property now stays in your pocket.
      </p>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
        The booking engine stack we deploy is yours — not the vendor's. Conversion data flows cleanly back into GA4 Analytics: readable, evaluable, optimizable. This is what makes Google Ads campaigns optimizable against actual reservations, not just clicks.
      </p>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-4xl mx-auto mb-8 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-8">
        What You Get
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex gap-4 items-start">
          <div class="w-2 h-2 rounded-full bg-primary mt-2 flex-shrink-0"></div>
          <div>
            <h3 class="font-bold text-charcoal dark:text-white mb-1">Hotel Engine Integration &amp; Standalone Villa Engine</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-2">We integrate tracking on Cloudbeds, SiteMinder, Little Hotelier, STAAH for hotels — or deploy our proprietary standalone booking engine for villas with no monthly license fees.</p>
            <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed">
              <span class="font-medium text-charcoal dark:text-white">Platforms we support:</span> Cloudbeds, SiteMinder, Little Hotelier, STAAH for hotels, and Alpha's standalone villa engine (Airbnb auto-sync).
            </p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-2 h-2 rounded-full bg-primary mt-2 flex-shrink-0"></div>
          <div>
            <h3 class="font-bold text-charcoal dark:text-white mb-1">PMS &amp; Channel Manager Integration</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">The booking engine connects to your existing property management system and channel manager — no need to scrap your current setup.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-2 h-2 rounded-full bg-primary mt-2 flex-shrink-0"></div>
          <div>
            <h3 class="font-bold text-charcoal dark:text-white mb-1">Reservation Data Flows into Ads &amp; GA4 Reports</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Every direct booking is recorded as a conversion in Google Ads and GA4 Analytics. You know exactly which keywords and campaigns drive actual reservations — critical for luxury hospitality properties managing large marketing budgets.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-2 h-2 rounded-full bg-primary mt-2 flex-shrink-0"></div>
          <div>
            <h3 class="font-bold text-charcoal dark:text-white mb-1">You Stay in Control — Switch Anytime</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Historical reservation data is yours. If you want to switch platforms down the line, we facilitate migration without data loss.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why no lock-in matters -->
  <section class="max-w-4xl mx-auto mb-8 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12">
      <h2 class="font-display font-bold text-xl md:text-2xl text-charcoal dark:text-white mb-4">
        Why "No Lock-In" Matters
      </h2>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
        Many booking engines in the Bali market follow a proprietary model: you pay a monthly license fee, reservation data lives in their system, and leaving means starting from zero.
      </p>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
        Alpha Digital takes the opposite stance: platform-agnostic. We install the best solution for your property today, and when your needs change, you are not trapped.
      </p>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
        This also means your direct booking data — guests, booking history, preferences — remains fully yours.
      </p>
    </div>
  </section>

  <!-- Proof anchor -->
  <section class="max-w-4xl mx-auto mb-8 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12">
      <h2 class="font-display font-bold text-xl md:text-2xl text-charcoal dark:text-white mb-4">
        Measurable Results
      </h2>
      <blockquote class="border-l-4 border-primary pl-6 py-2">
        <p class="text-slate-700 dark:text-slate-300 text-base leading-relaxed italic mb-2">
          "A 4-unit Bali villa property — direct bookings up 34% within 90 days after funnel audit, Google Ads optimization, and booking engine integration."
        </p>
        <cite class="text-xs font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400 not-italic">
          — Verified client data. Name withheld per client policy.
        </cite>
      </blockquote>
      <p class="text-slate-500 dark:text-slate-400 text-xs mt-4">Case Study #1 — full breakdown coming soon.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto mb-8 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-8">
        Questions About Booking Integration
      </h2>
      <div class="space-y-6">
        {faqItems.map((item) => (
          <div class="border-b border-slate-200 dark:border-slate-700 pb-6 last:border-0 last:pb-0">
            <h3 class="font-bold text-charcoal dark:text-white mb-2">{item.q}</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Internal links -->
  <section class="max-w-4xl mx-auto mb-12 px-6 md:px-12">
    <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-4 text-center">
      A booking engine is one of the key differentiators of a <a href="/" class="text-primary font-semibold hover:underline">digital marketing agency Bali for hotels and villas</a>: traffic does not stop at clicks, but flows into measurable direct reservations.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a href="/services/growth" class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-5 card-swiss block text-center">
        <p class="text-xs font-mono uppercase tracking-widest text-primary mb-2">Tier 2</p>
        <p class="font-bold text-charcoal dark:text-white">Growth →</p>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-1">Active Google Ads management</p>
      </a>
      <a href="/services/foundation" class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-5 card-swiss block text-center">
        <p class="text-xs font-mono uppercase tracking-widest text-primary mb-2">Tier 1</p>
        <p class="font-bold text-charcoal dark:text-white">Foundation →</p>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-1">Proper tracking across all channels</p>
      </a>
      <a href="/services/authority" class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-5 card-swiss block text-center">
        <p class="text-xs font-mono uppercase tracking-widest text-primary mb-2">Tier 3</p>
        <p class="font-bold text-charcoal dark:text-white">Authority →</p>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-1">All channels, multi-property</p>
      </a>
    </div>
  </section>

  <!-- Author byline -->
  <section class="max-w-4xl mx-auto mb-4 px-6 md:px-12">
    <p class="text-xs text-slate-500 dark:text-slate-400">
      Written by <a href="/daniel-santoso/" class="underline hover:text-primary">Daniel Santoso</a> · Last updated: May 2026
    </p>
  </section>

  <!-- Final CTA -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12 text-center">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-4">
        Ready to Install a Booking Engine?
      </h2>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-8 max-w-lg mx-auto">
        Tell us about your current system. We will explain the best integration options for your property — with no upfront commitment.
      </p>
      <a
        href="mailto:daniel@alphadigitalagency.id"
        class="btn-swiss inline-flex items-center gap-2 px-8 py-4 bg-primary text-white border-2 border-charcoal shadow-premium font-bold text-sm uppercase tracking-widest"
      >
        <Icon name="mail" class="" />
        Request a Proposal
      </a>
    </div>
  </section>
</SwissLayout>
