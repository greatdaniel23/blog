---
// EN mirror of /seo — convention mirror matching existing src/pages/en/*.astro files
// (prerendered static). The unified @graph for EN is emitted by the SSR page
// src/pages/seo.astro, which the worker serves for /en/* via X-Locale rewrite.
export const prerender = true;
import SwissLayout from "../../components/SwissLayout.astro";
import { WA_JASA } from "../../lib/linkbio";

const mainEntity = {
  "@type": "TechArticle",
  "@id": "https://alphadigitalagency.id/en/seo/#article",
  "headline": "SEO Is Not a Gimmick & Empty Promises: We Test on Ourselves First, Prove the Data, and Deploy for Your Property's Revenue Growth.",
  "description": "Most agencies promise 'Page 1 on Google' with bloated 40-page PDF reports full of vanity metrics that never book a single room. At Alpha Digital Agency, we publicly disclose our own 112-day Search Console data in Bali — proving that data-backed technical SEO attracts high-value decision-makers and high-yield guests without total reliance on 18–20% OTA commissions.",
  "inLanguage": "en",
  "datePublished": "2026-08-22T08:00:00+08:00",
  "dateModified": "2026-08-22T18:30:00+08:00",
  "author": {
    "@type": "Person",
    "@id": "https://alphadigitalagency.id/daniel-santoso/#person",
    "name": "Daniel Santoso",
    "jobTitle": "Founder & Google Ads Specialist",
    "url": "https://alphadigitalagency.id/daniel-santoso/"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://alphadigitalagency.id/#organization",
    "name": "Alpha Digital Agency",
    "url": "https://alphadigitalagency.id"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://alphadigitalagency.id/en/seo"
  }
};

const breadcrumbs = [
  { name: "Home", url: "/en" },
  { name: "SEO", url: "/en/seo" }
];

const faq = [
  {
    q: "Why does Alpha Digital Agency publicly disclose its own Search Console data?",
    a: "Because Trustworthiness in B2B partnerships is built on radical transparency. Hospitality clients trust us with their revenue growth; the best way to prove our technical execution is by showing our own verified organic results."
  },
  {
    q: "How long does organic SEO take to generate measurable direct bookings?",
    a: "SEO is a compounding business asset. On alphadigitalagency.id, impression volume surged +380% by Month 3. For villa and hotel properties, local indexability and search visibility improvements typically materialize in 4–8 weeks."
  },
  {
    q: "Are Alpha Digital blog articles generated purely by AI?",
    a: "We leverage AI for research synthesis and efficiency, but every piece of content must pass our 5-Block Semantic Outline Engine and human editorial review (E-E-A-T Quality Gate). We ensure every article includes practical calculations, real operational case studies, and engineering depth that generic AI prompts cannot produce."
  },
  {
    q: "How does organic SEO help villas reduce 18–20% OTA commissions?",
    a: "When prospective guests search for accommodations on Google, organic SEO captures that high-intent demand and routes it directly to your official website equipped with a Direct Booking Engine. This shifts 15–30% of bookings away from 18–20% OTA commissions into direct net revenue."
  },
  {
    q: "How can I request a comprehensive SEO audit for my property?",
    a: "Reach out via WhatsApp or email. Our team will conduct an exhaustive technical audit of your website architecture, Google Search Console, GA4 tracking setup, and Core Web Vitals free of charge with zero obligation."
  }
];
---

<SwissLayout
  title="SEO Is Not a Gimmick: Transparent Organic Growth Proof | Alpha Digital"
  description="Most agencies promise 'Page 1 on Google' with bloated 40-page PDF reports full of vanity metrics that never book a single room. At Alpha Digital Agency, we publicly disclose our own 112-day Search Console data in Bali — proving that data-backed technical SEO attracts high-value decision-makers and high-yield guests without total reliance on 18–20% OTA commissions."
  currentPage="seo"
  mainEntity={mainEntity}
  faq={faq}
  breadcrumbs={breadcrumbs}
>

  <!-- HERO SECTION -->
  <section class="max-w-4xl mx-auto mb-14 px-6 md:px-12 pt-28 md:pt-40">
    <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full border border-primary/30 bg-primary/10 text-primary font-mono text-xs font-bold uppercase tracking-wider mb-6">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span>Total Transparency · Hospitality B2B Growth</span>
    </div>
    
    <h1 class="font-display font-extrabold text-charcoal dark:text-white leading-display tracking-tightest">
      <span class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl block leading-tight">SEO Is Not a Gimmick & Empty Promises: We Test on Ourselves First, Prove the Data, and Deploy for Your Property's Revenue Growth.</span>
    </h1>
    
    <p class="mt-6 text-base md:text-lg text-slate-600 dark:text-slate-300 font-medium leading-relaxed max-w-3xl">
      Most agencies promise 'Page 1 on Google' with bloated 40-page PDF reports full of vanity metrics that never book a single room. At Alpha Digital Agency, we publicly disclose our own 112-day Search Console data in Bali — proving that data-backed technical SEO attracts high-value decision-makers and high-yield guests without total reliance on 18–20% OTA commissions.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4 text-xs font-mono text-slate-500 dark:text-slate-400">
      <span class="flex items-center space-x-1.5">
        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        <span>Author: <a href="/en/daniel-santoso" class="text-charcoal dark:text-white font-bold underline hover:text-primary">Daniel Santoso</a></span>
      </span>
      <span>•</span>
      <span class="flex items-center space-x-1.5">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>E-E-A-T Quality Verified</span>
      </span>
      <span>•</span>
      <span class="text-slate-400">August 2026</span>
    </div>
  </section>

  <!-- SECTION 1: THE DATA SCOREBOARD (FIRST-HAND EVIDENCE) -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8">
      <div class="mb-8">
        <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-2">Transparent Proof: 112 Days of Organic Growth at alphadigitalagency.id</h2>
        <p class="text-slate-600 dark:text-slate-400 text-sm">Real Google Search Console data (May – August 2026) with zero fabricated numbers.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
        <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-6 rounded-xl relative overflow-hidden">
          <div class="text-3xl sm:text-4xl font-extrabold text-primary font-mono tracking-tight mb-1">10,181</div>
          <div class="text-sm font-bold text-charcoal dark:text-white uppercase tracking-wider mb-2">Organic B2B Impressions</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-sans">+380% MoM Growth (May: 692 → July: 4,405) — Zero Ad Spend</div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-6 rounded-xl relative overflow-hidden">
          <div class="text-3xl sm:text-4xl font-extrabold text-primary font-mono tracking-tight mb-1">205</div>
          <div class="text-sm font-bold text-charcoal dark:text-white uppercase tracking-wider mb-2">High-Intent B2B Clicks</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-sans">+220% Acceleration (May: 25 → July: 80 clicks) from buyers seeking agency & AI solutions</div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-6 rounded-xl relative overflow-hidden">
          <div class="text-3xl sm:text-4xl font-extrabold text-primary font-mono tracking-tight mb-1">74.1%</div>
          <div class="text-sm font-bold text-charcoal dark:text-white uppercase tracking-wider mb-2">Desktop B2B Audience</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-sans">Researched directly by GMs, Villa Owners, & Marketing Directors from office workstations</div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-6 rounded-xl relative overflow-hidden">
          <div class="text-3xl sm:text-4xl font-extrabold text-primary font-mono tracking-tight mb-1">100 / 100</div>
          <div class="text-sm font-bold text-charcoal dark:text-white uppercase tracking-wider mb-2">Lighthouse SEO Score</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-sans">100% Valid Schema @graph, precise ID/EN Hreflang, & sub-100ms Serverless Edge delivery</div>
        </div>
      </div>

      <!-- Live Query Proof Callout -->
      <div class="border-t border-slate-200 dark:border-slate-800 pt-6">
        <h3 class="font-bold text-charcoal dark:text-white text-base mb-3">Verified Google Page 1 Commercial Rankings</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 mb-4">A snapshot of high-value commercial search queries ranked on Google Page 1 through 100% organic execution:</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono text-xs">
          <div class="bg-slate-100 dark:bg-slate-800/60 p-3.5 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <div>
              <span class="font-bold text-charcoal dark:text-white block font-sans">"alpha digital agency"</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-sans">Brand authority anchor (CTR 23.7%)</span>
            </div>
            <span class="px-2 py-1 rounded bg-primary/10 text-primary font-bold border border-primary/20">Pos 3.5</span>
          </div>

          <div class="bg-slate-100 dark:bg-slate-800/60 p-3.5 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <div>
              <span class="font-bold text-charcoal dark:text-white block font-sans">"marketing agency bali"</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-sans">High-value commercial B2B query (Page 1)</span>
            </div>
            <span class="px-2 py-1 rounded bg-primary/10 text-primary font-bold border border-primary/20">Pos 5.4</span>
          </div>

          <div class="bg-slate-100 dark:bg-slate-800/60 p-3.5 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <div>
              <span class="font-bold text-charcoal dark:text-white block font-sans">"digital agency bali"</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-sans">520 impressions — striking distance to Top 5</span>
            </div>
            <span class="px-2 py-1 rounded bg-primary/10 text-primary font-bold border border-primary/20">Pos 11.2</span>
          </div>

          <div class="bg-slate-100 dark:bg-slate-800/60 p-3.5 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <div>
              <span class="font-bold text-charcoal dark:text-white block font-sans">"ai agent booking hotel"</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-sans">High-intent hospitality AI query</span>
            </div>
            <span class="px-2 py-1 rounded bg-primary/10 text-primary font-bold border border-primary/20">Pos 5.0</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: THE 3-PILLAR PHILOSOPHY -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-3">Our 3-Pillar Methodology: We Test → We Believe → We Distribute</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-8">How our engineering discipline guarantees that every dollar and SEO strategy deployed for our clients stems from a rigorously proven framework.</p>

      <div class="space-y-8">
        <div class="border-l-4 border-primary pl-6 py-1">
          <div class="flex items-center space-x-3 mb-2">
            <span class="font-mono text-xs font-bold text-primary px-2 py-0.5 rounded bg-primary/10 border border-primary/20">01</span>
            <h3 class="font-bold text-lg md:text-xl text-charcoal dark:text-white">WE TEST — In Our Own Laboratory First (Skin in the Game)</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
            We never treat client properties as guinea pigs. Every technical component — from our 5-Block Semantic Outline framework, dynamic D1 sitemaps, Wikidata E-E-A-T entity graphs, to sub-100ms Core Web Vitals — is built and tested on our own domain. If a strategy doesn't grow our own organic business, we will never sell it to you.
          </p>
        </div>

        <div class="border-l-4 border-primary pl-6 py-1">
          <div class="flex items-center space-x-3 mb-2">
            <span class="font-mono text-xs font-bold text-primary px-2 py-0.5 rounded bg-primary/10 border border-primary/20">02</span>
            <h3 class="font-bold text-lg md:text-xl text-charcoal dark:text-white">WE BELIEVE — Driven by Verified Search Demand, Never Guesswork</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
            We refuse to publish low-effort fluff articles just to fulfill arbitrary blog quotas. Our B2B rule: 1 Content Piece = 1 Verified Google Search Query = 1 Target Hospitality Business Solution. We identify high-yield commercial queries in Search Console, then engineer exhaustive resources with real margin calculations and technical case studies.
          </p>
        </div>

        <div class="border-l-4 border-primary pl-6 py-1">
          <div class="flex items-center space-x-3 mb-2">
            <span class="font-mono text-xs font-bold text-primary px-2 py-0.5 rounded bg-primary/10 border border-primary/20">03</span>
            <h3 class="font-bold text-lg md:text-xl text-charcoal dark:text-white">WE DISTRIBUTE — Deploying Direct Booking Growth to Clients</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
            We deploy this exact battle-tested framework across our active hospitality clients in Bali (including Kayumanis Group and Piasan Restaurant). The outcome: over 100,000 monthly impressions and 3,600+ direct booking clicks that convert Google searchers into direct hotel guests — recovering tens of millions in 18–20% OTA commissions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: PITFALLS COMPARISON TABLE -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-3">Dissecting 'Agency Gimmick SEO' vs Alpha Digital SEO Engineering</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-8">Why generic hospitality SEO strategies fail to generate bookings and produce bloated reports that get discarded in executive wastebaskets.</p>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b-2 border-charcoal dark:border-white bg-slate-100 dark:bg-slate-800/80 font-mono text-xs uppercase text-charcoal dark:text-white">
              <th class="py-3 px-4 w-1/4">Evaluation Dimension</th>
              <th class="py-3 px-4 w-3/8 text-rose-600 dark:text-rose-400">Gimmick SEO & AI Spam</th>
              <th class="py-3 px-4 w-3/8 text-emerald-600 dark:text-emerald-400">Alpha Digital SEO Engineering (E-E-A-T)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
              <td class="py-4 px-4 font-bold text-charcoal dark:text-white">Keyword Strategy</td>
              <td class="py-4 px-4 text-slate-600 dark:text-slate-400 leading-relaxed bg-rose-500/5">Chasing broad dictionary definitions ('what is staycation') for vanity traffic graphs that never generate reservations.</td>
              <td class="py-4 px-4 text-slate-700 dark:text-slate-200 leading-relaxed font-medium bg-emerald-500/5">Targeting high-intent B2B & luxury travel queries ('luxury private villa bali direct booking', 'marketing agency bali').</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
              <td class="py-4 px-4 font-bold text-charcoal dark:text-white">Content Quality</td>
              <td class="py-4 px-4 text-slate-600 dark:text-slate-400 leading-relaxed bg-rose-500/5">Mass-generating 50 generic AI drafts in one day that sound repetitive, robotic, and risk severe Google algorithm penalties.</td>
              <td class="py-4 px-4 text-slate-700 dark:text-slate-200 leading-relaxed font-medium bg-emerald-500/5">5-Block Semantic Outlines: real business friction points, technical comparisons, live case studies, and E-E-A-T editorial rigor.</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
              <td class="py-4 px-4 font-bold text-charcoal dark:text-white">Technical Architecture</td>
              <td class="py-4 px-4 text-slate-600 dark:text-slate-400 leading-relaxed bg-rose-500/5">Bloated sites, heavy third-party chat widgets that destroy Core Web Vitals, broken schema, and redirect lag.</td>
              <td class="py-4 px-4 text-slate-700 dark:text-slate-200 leading-relaxed font-medium bg-emerald-500/5">100/100 Lighthouse SEO, ultra-fast serverless edge rendering, verified JSON-LD knowledge graphs, and seamless navigation.</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
              <td class="py-4 px-4 font-bold text-charcoal dark:text-white">Accountability & ROI</td>
              <td class="py-4 px-4 text-slate-600 dark:text-slate-400 leading-relaxed bg-rose-500/5">40-page monthly decks full of meaningless charts disconnected from actual room revenue or occupancy.</td>
              <td class="py-4 px-4 text-slate-700 dark:text-slate-200 leading-relaxed font-medium bg-emerald-500/5">Unified GA4 + GSC + Direct Booking Engine tracking measuring bottom-line metrics (booking inquiries, phone clicks, net revenue).</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SECTION 4: E-E-A-T AUTHOR SECTION -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8 flex flex-col md:flex-row items-start gap-8">
      <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-primary via-blue-600 to-indigo-700 flex-shrink-0 flex items-center justify-center text-white text-3xl font-extrabold shadow-lg">
        DS
      </div>
      <div>
        <div class="text-xs font-mono font-bold uppercase tracking-wider text-primary mb-1">Author Authority & Industry Credibility (E-E-A-T)</div>
        <h3 class="font-display font-bold text-2xl text-charcoal dark:text-white mb-1">
          <a href="/en/daniel-santoso" class="hover:text-primary underline">Daniel Santoso</a>
        </h3>
        <p class="text-xs font-mono text-slate-500 dark:text-slate-400 mb-4">Founder & Google Ads Specialist (9 Years Hospitality Depth in Bali)</p>
        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-4">
          Daniel Santoso leads Alpha Digital Agency with an uncompromising data-first methodology. Backed by 9 years of orchestrating Google Ads campaigns, analytics tracking, and direct booking acquisition for luxury villas, boutique resorts, and acclaimed dining venues across Bali, every SEO architecture is engineered against the operational realities and profit margins of tourism businesses.
        </p>
        
        <div class="flex flex-wrap gap-2 text-xs font-mono">
          <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700">Google Ads Specialist</span>
          <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700">GA4 & Data Analytics</span>
          <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700">Hospitality Direct Booking</span>
          <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700">Entity SEO Architect</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: FAQ -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-8">Strategic Questions About Hospitality SEO Investment</h2>
      <div class="space-y-6">
        {faq.map((item) => (
          <div class="border-b border-slate-200 dark:border-slate-800 pb-6 last:border-0 last:pb-0">
            <h3 class="font-bold text-base md:text-lg text-charcoal dark:text-white mb-2.5">{item.q}</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 6: FINAL CTA -->
  <section class="max-w-4xl mx-auto pb-16 px-6 md:px-12">
    <div class="bg-charcoal text-white dark:bg-slate-950 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 text-center rounded-2xl">
      <h2 class="font-display font-extrabold text-2xl md:text-4xl mb-4">{tx.ctaTitle}</h2>
      <p class="text-slate-300 text-sm md:text-base max-w-2xl mx-auto leading-relaxed mb-8">{tx.ctaDesc}</p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={WA_JASA} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-8 py-3.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm rounded-xl transition shadow-lg shadow-emerald-500/20 flex items-center justify-center space-x-2"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          <span>{tx.ctaWa}</span>
        </a>
        <a 
