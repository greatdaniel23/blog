---
// EN mirror of /seo — convention mirror matching existing src/pages/en/*.astro files
// (prerendered static). The unified @graph for EN is emitted by the SSR page
// src/pages/seo.astro, which the worker serves for /en/* via X-Locale rewrite.
export const prerender = true;
import SwissLayout from "../../components/SwissLayout.astro";
import { WA_JASA } from "../../lib/linkbio";

const mainEntity = {
  "@type": "TechArticle",
  "@id": "https://alphadigitalagency.id/en/seo/#article",
  "headline": "SEO Is Not a Gimmick: We Test on Ourselves First, We Believe the Data, We Deploy for You.",
  "description": "Many agencies promise page-one rankings and thousands of clicks, yet their own agency website gets zero organic traffic. At Alpha Digital Agency, we never sell what we haven't proven ourselves. Here is the uncensored 112-day organic growth data of alphadigitalagency.id.",
  "inLanguage": "en",
  "datePublished": "2026-08-22T08:00:00+08:00",
  "dateModified": "2026-08-22T18:30:00+08:00",
  "author": {
    "@type": "Person",
    "@id": "https://alphadigitalagency.id/daniel-santoso/#person",
    "name": "Daniel Santoso",
    "jobTitle": "Founder & Google Ads Specialist",
    "url": "https://alphadigitalagency.id/daniel-santoso/"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://alphadigitalagency.id/#organization",
    "name": "Alpha Digital Agency",
    "url": "https://alphadigitalagency.id"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://alphadigitalagency.id/en/seo"
  }
};

const breadcrumbs = [
  { name: "Home", url: "/en" },
  { name: "SEO", url: "/en/seo" }
];

const faq = [
  {
    q: "Why does Alpha Digital Agency publicly disclose its own Search Console data?",
    a: "Because Trustworthiness is built on radical transparency. Hospitality clients trust us with their revenue growth; the best way to prove our technical execution is by demonstrating that we can grow our own digital assets organically."
  },
  {
    q: "How long does organic SEO take to generate measurable results?",
    a: "SEO is a compounding asset. On alphadigitalagency.id, impression volume accelerated significantly within the first 60 days following our technical architecture and 48 published bilingual pillar posts, surging +380% by Month 3. For villa and hotel properties, local indexability and search visibility improvements typically materialize in 4–8 weeks."
  },
  {
    q: "Are Alpha Digital blog articles written entirely by AI?",
    a: "We leverage AI for research synthesis and structural mapping, but every piece of content must pass our 5-Block Semantic Outline Engine and human editorial review (E-E-A-T Quality Gate). We ensure every article includes practical calculations, real operational case studies, and engineering depth that generic AI prompts cannot produce."
  },
  {
    q: "How does organic SEO help villas reduce OTA commissions?",
    a: "When prospective guests search for accommodations in Bali, organic SEO captures that high-intent demand on Google and routes it directly to your official website equipped with a direct booking engine. This shifts 15–30% of reservations away from 18–20% OTA commissions into direct net revenue."
  },
  {
    q: "How can I request an SEO audit for my property?",
    a: "Reach out via WhatsApp or our consultation form. We will conduct an exhaustive technical audit of your website, Search Console, GA4 setup, and Core Web Vitals free of charge with zero obligation."
  }
];
---

<SwissLayout
  title="SEO Is Not a Gimmick: Transparent Organic Growth Proof | Alpha Digital"
  description="Many agencies promise page-one rankings and thousands of clicks, yet their own agency website gets zero organic traffic. At Alpha Digital Agency, we never sell what we haven't proven ourselves. Here is the uncensored 112-day organic growth data of alphadigitalagency.id."
  currentPage="seo"
  mainEntity={mainEntity}
  faq={faq}
  breadcrumbs={breadcrumbs}
>

  <!-- HERO SECTION -->
  <section class="max-w-4xl mx-auto mb-14 px-6 md:px-12 pt-28 md:pt-40">
    <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full border border-primary/30 bg-primary/10 text-primary font-mono text-xs font-bold uppercase tracking-wider mb-6">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span>Transparent SEO Practice · Skin in the Game</span>
    </div>
    
    <h1 class="font-display font-extrabold text-charcoal dark:text-white leading-display tracking-tightest">
      <span class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl block leading-tight">SEO Is Not a Gimmick: We Test on Ourselves First, We Believe the Data, We Deploy for You.</span>
    </h1>
    
    <p class="mt-6 text-base md:text-lg text-slate-600 dark:text-slate-300 font-medium leading-relaxed max-w-3xl">
      Many agencies promise page-one rankings and thousands of clicks, yet their own agency website gets zero organic traffic. At Alpha Digital Agency, we never sell what we haven't proven ourselves. Here is the uncensored 112-day organic growth data of alphadigitalagency.id.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4 text-xs font-mono text-slate-500 dark:text-slate-400">
      <span class="flex items-center space-x-1.5">
        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        <span>Author: <a href="/en/daniel-santoso" class="text-charcoal dark:text-white font-bold underline hover:text-primary">Daniel Santoso</a></span>
      </span>
      <span>•</span>
      <span class="flex items-center space-x-1.5">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>E-E-A-T Quality Verified</span>
      </span>
      <span>•</span>
      <span class="text-slate-400">August 2026</span>
    </div>
  </section>

  <!-- SECTION 1: THE DATA SCOREBOARD (FIRST-HAND EVIDENCE) -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8">
      <div class="mb-8">
        <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-2">Transparent Proof: 112 Days of Organic Growth at alphadigitalagency.id</h2>
        <p class="text-slate-600 dark:text-slate-400 text-sm">Real Google Search Console data (May – August 2026) with zero fabricated numbers.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
        <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-6 rounded-xl relative overflow-hidden">
          <div class="text-3xl sm:text-4xl font-extrabold text-primary font-mono tracking-tight mb-1">10,181</div>
          <div class="text-sm font-bold text-charcoal dark:text-white uppercase tracking-wider mb-2">Total Organic Impressions</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-sans">+380% MoM (May: 692 → July: 4,405)</div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-6 rounded-xl relative overflow-hidden">
          <div class="text-3xl sm:text-4xl font-extrabold text-primary font-mono tracking-tight mb-1">205</div>
          <div class="text-sm font-bold text-charcoal dark:text-white uppercase tracking-wider mb-2">B2B Organic Clicks</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-sans">+220% MoM (May: 25 → July: 80 clicks)</div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-6 rounded-xl relative overflow-hidden">
          <div class="text-3xl sm:text-4xl font-extrabold text-primary font-mono tracking-tight mb-1">74.1%</div>
          <div class="text-sm font-bold text-charcoal dark:text-white uppercase tracking-wider mb-2">Desktop Traffic (B2B Intent)</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-sans">Villa owners & GMs searching from office desks</div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-6 rounded-xl relative overflow-hidden">
          <div class="text-3xl sm:text-4xl font-extrabold text-primary font-mono tracking-tight mb-1">100 / 100</div>
          <div class="text-sm font-bold text-charcoal dark:text-white uppercase tracking-wider mb-2">Lighthouse SEO Score</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-sans">100% Canonical, Hreflang & Schema Valid</div>
        </div>
      </div>

      <!-- Live Query Proof Callout -->
      <div class="border-t border-slate-200 dark:border-slate-800 pt-6">
        <h3 class="font-bold text-charcoal dark:text-white text-base mb-3">Verified Google Search Rankings</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 mb-4">A snapshot of high-value commercial search queries ranked on Google Page 1:</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono text-xs">
          <div class="bg-slate-100 dark:bg-slate-800/60 p-3.5 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <div>
              <span class="font-bold text-charcoal dark:text-white block font-sans">"alpha digital agency"</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-sans">Brand authority anchor (CTR 23.7%)</span>
            </div>
            <span class="px-2 py-1 rounded bg-primary/10 text-primary font-bold border border-primary/20">Pos 3.5</span>
          </div>

          <div class="bg-slate-100 dark:bg-slate-800/60 p-3.5 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <div>
              <span class="font-bold text-charcoal dark:text-white block font-sans">"marketing agency bali"</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-sans">High-value commercial B2B query (Page 1)</span>
            </div>
            <span class="px-2 py-1 rounded bg-primary/10 text-primary font-bold border border-primary/20">Pos 5.4</span>
          </div>

          <div class="bg-slate-100 dark:bg-slate-800/60 p-3.5 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <div>
              <span class="font-bold text-charcoal dark:text-white block font-sans">"digital agency bali"</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-sans">520 impressions — striking distance to Top 5</span>
            </div>
            <span class="px-2 py-1 rounded bg-primary/10 text-primary font-bold border border-primary/20">Pos 11.2</span>
          </div>

          <div class="bg-slate-100 dark:bg-slate-800/60 p-3.5 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <div>
              <span class="font-bold text-charcoal dark:text-white block font-sans">"ai agent booking hotel"</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-sans">High-intent hospitality AI query</span>
            </div>
            <span class="px-2 py-1 rounded bg-primary/10 text-primary font-bold border border-primary/20">Pos 5.0</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: THE 3-PILLAR PHILOSOPHY -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-3">Our 3-Pillar Methodology: Test → Believe → Distribute</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-8">How we guarantee that every SEO strategy deployed for our clients is the direct result of rigorous, verified engineering.</p>

      <div class="space-y-8">
        <div class="border-l-4 border-primary pl-6 py-1">
          <div class="flex items-center space-x-3 mb-2">
            <span class="font-mono text-xs font-bold text-primary px-2 py-0.5 rounded bg-primary/10 border border-primary/20">01</span>
            <h3 class="font-bold text-lg md:text-xl text-charcoal dark:text-white">WE TEST — In Our Own Laboratory First</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
            Before offering SEO services for your villa or hotel, we test all technical architecture on our own domain: from the 5-Block Semantic Outline framework, dynamic D1 sitemaps, Wikidata E-E-A-T entity linking, to sub-100ms Core Web Vitals response times. We maintain active skin in the game.
          </p>
        </div>

        <div class="border-l-4 border-primary pl-6 py-1">
          <div class="flex items-center space-x-3 mb-2">
            <span class="font-mono text-xs font-bold text-primary px-2 py-0.5 rounded bg-primary/10 border border-primary/20">02</span>
            <h3 class="font-bold text-lg md:text-xl text-charcoal dark:text-white">WE BELIEVE — Driven by Real Demand, Never Guesswork</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
            We never write random fluff articles just to fulfill arbitrary blog quotas. Our rule: 1 Post = 1 Real GSC Search Query = 1 Product Solution Target. When Search Console data proves high-value commercial search intent, we produce an exhaustive, high-information-gain resource.
          </p>
        </div>

        <div class="border-l-4 border-primary pl-6 py-1">
          <div class="flex items-center space-x-3 mb-2">
            <span class="font-mono text-xs font-bold text-primary px-2 py-0.5 rounded bg-primary/10 border border-primary/20">03</span>
            <h3 class="font-bold text-lg md:text-xl text-charcoal dark:text-white">WE DISTRIBUTE — The Exact Same Rigor for Clients</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
            We deploy the exact same methodology across our active Bali hospitality clients (including Kayumanis Group and Piasan Restaurant), consistently generating over 100,000 monthly organic impressions and 3,600+ direct booking clicks without relying entirely on 18–20% OTA commissions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: PITFALLS COMPARISON TABLE -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-3">Dissecting 'Gimmick SEO' vs True SEO Engineering</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-8">Why generic agency SEO tactics fail to generate reservations and only produce bloated, useless 50-page reports.</p>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b-2 border-charcoal dark:border-white bg-slate-100 dark:bg-slate-800/80 font-mono text-xs uppercase text-charcoal dark:text-white">
              <th class="py-3 px-4 w-1/4">Dimension</th>
              <th class="py-3 px-4 w-3/8 text-rose-600 dark:text-rose-400">Gimmick SEO / AI Spam</th>
              <th class="py-3 px-4 w-3/8 text-emerald-600 dark:text-emerald-400">Alpha Digital Engineering (E-E-A-T)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
              <td class="py-4 px-4 font-bold text-charcoal dark:text-white">Keyword Strategy</td>
              <td class="py-4 px-4 text-slate-600 dark:text-slate-400 leading-relaxed bg-rose-500/5">Chasing broad dictionary definitions ('what is holiday') for fake vanity traffic.</td>
              <td class="py-4 px-4 text-slate-700 dark:text-slate-200 leading-relaxed font-medium bg-emerald-500/5">Targeting high-intent B2B commercial queries ('marketing agency bali', 'direct booking vs ota cost').</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
              <td class="py-4 px-4 font-bold text-charcoal dark:text-white">Content Quality</td>
              <td class="py-4 px-4 text-slate-600 dark:text-slate-400 leading-relaxed bg-rose-500/5">Mass-generating 50 generic AI drafts in one day that sound repetitive and robotic.</td>
              <td class="py-4 px-4 text-slate-700 dark:text-slate-200 leading-relaxed font-medium bg-emerald-500/5">5-Block Semantic Outlines: real friction points, exact math formulas, technical comparisons, and live case studies.</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
              <td class="py-4 px-4 font-bold text-charcoal dark:text-white">Technical Foundation</td>
              <td class="py-4 px-4 text-slate-600 dark:text-slate-400 leading-relaxed bg-rose-500/5">Slow page loads, heavy render-blocking chat widgets, broken schema, and redirect loops.</td>
              <td class="py-4 px-4 text-slate-700 dark:text-slate-200 leading-relaxed font-medium bg-emerald-500/5">100/100 Lighthouse SEO, valid @graph JSON-LD schema, precise ID/EN hreflang, and ultra-fast edge delivery.</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
              <td class="py-4 px-4 font-bold text-charcoal dark:text-white">Outcome & Tracking</td>
              <td class="py-4 px-4 text-slate-600 dark:text-slate-400 leading-relaxed bg-rose-500/5">50-page monthly decks full of vanity charts disconnected from actual room revenue.</td>
              <td class="py-4 px-4 text-slate-700 dark:text-slate-200 leading-relaxed font-medium bg-emerald-500/5">Unified GA4 + GSC + Booking Engine tracking measuring direct reservations and ROI.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SECTION 4: E-E-A-T AUTHOR SECTION -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8 flex flex-col md:flex-row items-start gap-8">
      <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-primary via-blue-600 to-indigo-700 flex-shrink-0 flex items-center justify-center text-white text-3xl font-extrabold shadow-lg">
        DS
      </div>
      <div>
        <div class="text-xs font-mono font-bold uppercase tracking-wider text-primary mb-1">About the Author & E-E-A-T Standards</div>
        <h3 class="font-display font-bold text-2xl text-charcoal dark:text-white mb-1">
          <a href="/en/daniel-santoso" class="hover:text-primary underline">Daniel Santoso</a>
        </h3>
        <p class="text-xs font-mono text-slate-500 dark:text-slate-400 mb-4">Founder & Google Ads Specialist (9 Years Hospitality Experience in Bali)</p>
        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-4">
          Daniel Santoso leads Alpha Digital Agency with a rigorous, no-nonsense data approach. Backed by 9 years of managing Google Ads campaigns and digital analytics for luxury villas, boutique hotels, and premier restaurants across Bali, every article and SEO strategy is strictly vetted against the operational realities of the hospitality business.
        </p>
        
        <div class="flex flex-wrap gap-2 text-xs font-mono">
          <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700">Google Ads Specialist</span>
          <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700">GA4 & Data Analytics</span>
          <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700">Hospitality Direct Booking</span>
          <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700">Entity SEO Architect</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: FAQ -->
  <section class="max-w-4xl mx-auto mb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-8">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-8">Frequently Asked Questions About Transparent SEO</h2>
      <div class="space-y-6">
        {faq.map((item) => (
          <div class="border-b border-slate-200 dark:border-slate-800 pb-6 last:border-0 last:pb-0">
            <h3 class="font-bold text-base md:text-lg text-charcoal dark:text-white mb-2.5">{item.q}</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 6: FINAL CTA -->
  <section class="max-w-4xl mx-auto pb-16 px-6 md:px-12">
    <div class="bg-charcoal text-white dark:bg-slate-950 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 text-center rounded-2xl">
      <h2 class="font-display font-extrabold text-2xl md:text-4xl mb-4">Ready to Test the Power of Organic SEO for Your Property?</h2>
      <p class="text-slate-300 text-sm md:text-base max-w-2xl mx-auto leading-relaxed mb-8">Let's analyze the organic search potential of your villa or hotel. We start with a comprehensive SEO & tracking audit — transparent, measurable, and zero commitment.</p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={WA_JASA} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-8 py-3.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm rounded-xl transition shadow-lg shadow-emerald-500/20 flex items-center justify-center space-x-2"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          <span>WhatsApp Consultation</span>
        </a>
        <a 
          href="mailto:daniel@alphadigitalagency.id" 
          class="w-full sm:w-auto px-8 py-3.5 bg-white/10 hover:bg-white/20 text-white font-bold text-sm rounded-xl border border-white/20 transition flex items-center justify-center space-x-2"
        >
