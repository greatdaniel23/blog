---
// SSR required — reads Astro.locals.locale set by middleware via X-Locale header
import SwissLayout from "../components/SwissLayout.astro";

const locale = (Astro.locals as any).locale || 'id';
const isEn = locale === 'en';

const t = {
  id: {
    metaTitle: "Digital Marketing Agency Bali | Alpha Digital",
    metaDesc: "Digital marketing agency Bali for hotels and villas: Google Ads, SEO, booking engine, GA4 tracking, AI agents, and direct booking growth.",
    heroH1: "Digital marketing agency Bali untuk hotel dan vila.",
    heroSub: "Kami gabungkan Google Ads, SEO, booking engine, GA4 tracking, dan AI Agent dalam satu sistem, supaya setiap rupiah marketing kelihatan hasilnya. Spesialis hospitality Bali yang ingin kurangi ketergantungan OTA.",
    heroH2: "Kami menganalisis jalur konversi — booking funnel audit secara otomatis",
    tier1Label: "Tier 1", tier1Title: "Foundation", tier1Desc: "Tracking benar sebelum scale iklan.",
    tier2Label: "Tier 2", tier2Title: "Growth", tier2Desc: "Google Ads + audit funnel booking.",
    tier3Label: "Tier 3", tier3Title: "Authority", tier3Desc: "Semua channel, satu laporan.",
    tier4Label: "Tier 4", tier4Title: "Booking Engine", tier4Desc: "Install & kelola, tanpa lock-in.",
    ctaMail: "Minta Penawaran",
    ctaPhone: "0895-3687-07977 / 0881-480-2249",
    answerH2: "Apa yang membuat Alpha Digital Agency berbeda dari agency digital lain di Bali?",
    answerP: "Alpha Digital Agency Indonesia adalah agensi spesialis industri perhotelan mewah (luxury hospitality) di Bali — fokus pada vila, hotel boutique, dan restoran. Tidak seperti agency umum, kami membangun AI Agents yang menghubungkan data Google Ads, pencarian organik, dan GA4 ke dalam satu ekosistem terpadu. Sistem ini menganalisis jalur konversi (booking funnel audit) secara otomatis, sehingga setiap rupiah iklan yang dikeluarkan terlacak hingga ke reservasi langsung. Hasilnya: pengurangan ketergantungan OTA dan peningkatan ROI yang terukur — bukan laporan vanity metric.",
    compareLabel: "Digital Marketing Agency Bali",
    compareH2: "Digital Marketing Agency Bali for Hospitality Businesses",
    compareP1: "Banyak bisnis mencari digital marketing Bali karena butuh website, iklan, konten, atau SEO. Untuk hotel, vila, dan restoran, masalahnya lebih spesifik: traffic harus berubah menjadi reservasi langsung, data iklan harus tersambung ke booking engine, dan laporan harus menunjukkan channel mana yang benar-benar menghasilkan revenue.",
    compareP2: "Alpha Digital tidak memposisikan diri sebagai agency umum untuk semua industri. Kami adalah digital marketing agency in Bali yang fokus pada hospitality: Google Ads, SEO, GA4/GTM tracking, booking engine integration, dan AI Agent yang membantu tamu sebelum mereka pindah ke OTA. Dalam istilah yang lebih sempit, kami juga tetap relevan untuk pencarian digital agency Bali, tapi fokus kami lebih besar: sistem marketing yang menghasilkan booking.",
    compareP3: "Jika Anda mengelola properti di Bali, memilih digital marketing agency Bali seharusnya bukan hanya soal siapa yang bisa membuat konten terlihat bagus. Yang lebih penting adalah siapa yang bisa membaca Search Console, menghubungkan campaign Google Ads ke conversion value, memperbaiki halaman yang bocor, dan membangun sistem direct booking yang bisa dievaluasi setiap bulan.",
    compareP4: "Karena itu homepage ini menjadi pusat layanan Alpha: dari Google Ads untuk hotel dan vila, booking engine integration, AI Agent untuk hospitality, sampai ekosistem digital hospitality yang menyatukan traffic, website, reservasi, dan reporting.",
    compareBoxH3: "How Alpha Compares",
    creativeLabel: "Creative agency", creativeDesc: "Strong for brand identity, photo/video, and campaign look. Often weaker on booking attribution and revenue tracking.",
    socialLabel: "Social media agency", socialDesc: "Strong for posting cadence and engagement. Not always built around high-intent Google search and direct reservations.",
    webLabel: "Web agency", webDesc: "Strong for interface and development. Often stops before Google Ads, GA4, Search Console, and booking-engine feedback loops.",
    alphaLabel: "Alpha Digital", alphaDesc: "Hospitality digital infrastructure: ads, SEO, booking engine, AI Agent, and reporting connected into one direct-booking system for Bali properties.",
    faqTitle: "Pertanyaan yang Sering Kami Terima",
    faq: [
      { q: "Apa yang membedakan Alpha Digital dari agency lain di Bali?", a: "Alpha Digital menggabungkan Google Ads, SEO organik, dan booking engine langsung dalam satu sistem laporan. Bukan tiga vendor terpisah — satu tim, satu data, satu tujuan: reservasi langsung lebih banyak." },
      { q: "Apa itu digital marketing agency Bali untuk hospitality?", a: "Digital marketing agency Bali untuk hospitality adalah partner yang memahami pasar hotel, vila, restoran, OTA, direct booking, dan tracking reservasi. Alpha Digital fokus di titik itu: Google Ads, SEO, booking engine, GA4, dan AI Agent yang saling terhubung." },
      { q: "Apa bedanya Alpha Digital dengan creative agency atau social media agency?", a: "Creative agency biasanya fokus pada brand dan konten visual. Social media agency fokus pada kalender konten dan engagement. Alpha Digital fokus pada sistem pendapatan digital: iklan, SEO, tracking, booking engine, dan laporan reservasi langsung." },
      { q: "Apakah Alpha Digital hanya melayani vila dan hotel di Bali?", a: "Spesialisasi kami adalah hospitality Bali — vila, hotel boutique, dan restoran. Kami tidak melayani semua industri karena fokus adalah kunci hasil terbaik." },
      { q: "Layanan apa yang sebaiknya dimiliki digital marketing agency Bali untuk hotel?", a: "Minimal harus bisa mengelola Google Ads, membaca Search Console, memasang GA4/GTM, memperbaiki website, memahami booking engine, dan mengukur direct booking. Tanpa itu, laporan marketing mudah berhenti di klik dan engagement." },
      { q: "Berapa lama sebelum saya melihat hasil dari Google Ads?", a: "Kampanye Google Ads biasanya mulai menghasilkan data bermakna dalam 2–4 minggu pertama. Optimasi dilakukan dua minggu sekali berdasarkan data nyata, bukan asumsi." },
      { q: "Apakah saya perlu sudah punya website untuk mulai?", a: "Tidak harus. Kami bisa audit website yang sudah ada, atau bantu dari awal. Yang paling penting adalah tracking yang benar sebelum budget iklan dibakar." },
      { q: "Bagaimana cara memulai dengan Alpha Digital?", a: "Kirim email ke daniel@alphadigitalagency.id atau WhatsApp ke 0895-3687-07977 / 0881-480-2249. Kami mulai dengan audit cepat situasi digital properti Anda — gratis, tanpa komitmen." }
    ],
    author: "Ditulis oleh <a href=\"/daniel-santoso/\" class=\"underline hover:text-primary\">Daniel Santoso</a> · Terakhir diperbarui: Mei 2026",
    aiGreeting: "Halo! Saya asisten Alpha Digital. Ada yang bisa saya bantu soal digital marketing bisnis Anda?",
    serviceUrl: "/services",
    pageUrl: "https://alphadigitalagency.id/"
  },
  en: {
    metaTitle: "Alpha Digital Agency — Bali Digital Agency for Google Ads & AI",
    metaDesc: "Alpha Digital is the premier digital agency in Bali for hotels, villas, and restaurants. Google Ads, SEO, Direct Booking Engine, and AI Agent specialists.",
    heroH1: "Digital Marketing That Actually Works for Bali Hospitality",
    heroSub: "Bali digital agency for hotels, villas, and restaurants. Google Ads, SEO, Direct Booking Engine, and AI Agent — ensuring technology is implemented correctly for measurable results.",
    heroH2: "We analyze conversion paths — automated booking funnel audits",
    tier1Label: "Tier 1", tier1Title: "Foundation", tier1Desc: "Proper tracking before scaling ads.",
    tier2Label: "Tier 2", tier2Title: "Growth", tier2Desc: "Google Ads + bi-weekly funnel audit.",
    tier3Label: "Tier 3", tier3Title: "Authority", tier3Desc: "All channels, one report.",
    tier4Label: "Tier 4", tier4Title: "Booking Engine", tier4Desc: "Install & manage, no lock-in.",
    ctaMail: "Request a Proposal",
    ctaPhone: "0895-3687-07977 / 0881-480-2249",
    answerH2: "What makes Alpha Digital Agency different from other digital agencies in Bali?",
    answerP: "Alpha Digital Agency Indonesia is a luxury hospitality specialist in Bali — focused on villas, boutique hotels, and restaurants. Unlike general agencies, we build AI Agents that connect Google Ads, organic search, and GA4 data into one unified ecosystem. This system analyzes conversion paths (booking funnel audit) automatically, so every rupiah of ad spend is traced through to direct reservations. The result: reduced OTA dependency and measurable ROI — not vanity metric reports.",
    compareLabel: "Digital Marketing Agency Bali",
    compareH2: "Digital Marketing Agency Bali for Hospitality Businesses",
    compareP1: "Many businesses search for digital marketing Bali because they need a website, ads, content, or SEO. For hotels, villas, and restaurants, the problem is more specific: traffic must convert into direct reservations, ad data must connect to the booking engine, and reports must show which channels actually generate revenue.",
    compareP2: "Alpha Digital does not position itself as a general agency for all industries. We are a digital marketing agency in Bali focused on hospitality: Google Ads, SEO, GA4/GTM tracking, booking engine integration, and AI Agents that assist guests before they move to an OTA. In narrower terms, we remain relevant for digital agency Bali searches, but our focus is larger: marketing systems that generate bookings.",
    compareP3: "If you manage a property in Bali, choosing a digital marketing agency Bali should not just be about who can make content look good. What matters more is who can read Search Console, connect Google Ads campaigns to conversion value, fix leaking pages, and build a direct booking system that can be evaluated every month.",
    compareP4: "That is why this homepage serves as Alpha's service hub: from Google Ads for hotels and villas, booking engine integration, AI Agent for hospitality, to the digital hospitality ecosystem that unifies traffic, website, reservations, and reporting.",
    compareBoxH3: "How Alpha Compares",
    creativeLabel: "Creative agency", creativeDesc: "Strong for brand identity, photo/video, and campaign look. Often weaker on booking attribution and revenue tracking.",
    socialLabel: "Social media agency", socialDesc: "Strong for posting cadence and engagement. Not always built around high-intent Google search and direct reservations.",
    webLabel: "Web agency", webDesc: "Strong for interface and development. Often stops before Google Ads, GA4, Search Console, and booking-engine feedback loops.",
    alphaLabel: "Alpha Digital", alphaDesc: "Hospitality digital infrastructure: ads, SEO, booking engine, AI Agent, and reporting connected into one direct-booking system for Bali properties.",
    faqTitle: "Frequently Asked Questions",
    faq: [
      { q: "What sets Alpha Digital apart from other Bali agencies?", a: "We are the first agency in Bali to openly declare end-to-end AI/LLM usage. We don't just sell tech — we ensure your digital marketing technology is implemented correctly for clear, measurable villa business results." },
      { q: "Do you only serve hotels and villas?", a: "Hospitality is our core specialization — villas, hotels, and restaurants in Bali. We also serve select luxury brands where our Google Ads + AI expertise transfers directly." },
      { q: "What is a Direct Booking Engine and why do I need one?", a: "A direct booking engine lets guests book directly on your website with 0% OTA commission. It complements OTAs (which bring discovery) by capturing repeat and direct bookings — owning your guest relationship and data." },
      { q: "How does the AI Agent work?", a: "Trained on your property data — rooms, rates, facilities, policies, FAQ. Answers guest questions 24/7 in multiple languages and routes them to your booking engine. Never sleeps, never takes a day off." },
      { q: "How long until I see results from Google Ads?", a: "Typically 2-4 weeks for campaign stabilization and data collection. Real optimization begins after 30 days when we have enough conversion data. We focus on ROAS (Return on Ad Spend), not just clicks." },
      { q: "Do you offer website development?", a: "Yes — focused on high-performance hospitality websites. Astro SSR on Cloudflare global network. Ultra-fast, mobile-first, SEO-optimized, with direct booking integration." }
    ],
    author: "Written by <a href=\"/daniel-santoso/\" class=\"underline hover:text-primary\">Daniel Santoso</a> · Last updated: May 2026",
    aiGreeting: "Hello! I'm the Alpha Digital assistant. How can I help with your digital marketing needs?",
    serviceUrl: "/en/services",
    pageUrl: "https://alphadigitalagency.id/"
  }
};

const tx = t[locale] || t.id;

// Unified @graph page nodes (KG-SEO v3 Phase A) — the old localBusinessLD/
// homeFaqLD/homeBreadcrumbLD blocks are replaced by the sitewide LocalBusiness
// in SeoGraph (dedup) + the props below (ProfessionalService main entity, FAQ,
// breadcrumb) inside the single @graph block.
const mainEntity = {
  "@type": "ProfessionalService",
  // Unifies with the sitewide ProfessionalService node emitted by SeoGraph —
  // same @id ⇒ single entity in the graph (Gap #3 dedup discipline), not a
  // duplicate ProfessionalService per page.
  "@id": "https://alphadigitalagency.id/#professionalservice",
  "parentOrganization": { "@id": "https://alphadigitalagency.id/#organization" },
  "name": "Alpha Digital Agency Indonesia",
  "url": "https://alphadigitalagency.id",
  "serviceType": ["Google Ads Management", "Hospitality SEO", "Booking Engine Integration", "AI Agent Implementation", "GA4 and Search Console Tracking"],
  "address": { "@type": "PostalAddress", "addressLocality": "Denpasar", "addressRegion": "Bali", "addressCountry": "ID" },
  "geo": { "@type": "GeoCoordinates", "latitude": -8.6705, "longitude": 115.2126 },
  "priceRange": "$$",
  "telephone": ["+6289536870777", "+628814802249"],
  "areaServed": { "@type": "Place", "name": "Bali, Indonesia" },
};
const faq = tx.faq;
const breadcrumbs = [ { name: "Home", url: "/" } ];
// WebPage.about — Wikidata-verified QIDs (Gap #6). No fabricated IDs.
const about = [
  { name: "Digital Marketing", sameAs: "https://www.wikidata.org/wiki/Q1323528" },
  { name: "Google Ads", sameAs: "https://www.wikidata.org/wiki/Q271982" },
  { name: "Bali", sameAs: "https://www.wikidata.org/wiki/Q3125978" },
];
---

<SwissLayout title={tx.metaTitle} description={tx.metaDesc} currentPage="home" mainEntity={mainEntity} faq={faq} breadcrumbs={breadcrumbs} about={about}>
  <Fragment slot="head">
  </Fragment>

  <!-- Hero -->
  <section class="relative flex-1 flex flex-col items-center justify-center min-h-[calc(100svh-80px)] w-full px-4 pb-24 md:pb-12">
    <div class="absolute inset-0 bg-radial-gradient from-emerald-500/5 to-transparent hidden md:block md:blur-[100px] pointer-events-none z-0"></div>
    <div class="relative z-10 flex flex-col items-center justify-center max-w-[1400px] w-full text-center gap-3 lg:gap-4">
      <div class="flex-none mb-3 md:mb-4">
        <h1 class="flex flex-col items-center font-display font-extrabold text-charcoal dark:text-white leading-display tracking-tightest">
          <span class="text-[2rem] sm:text-[2.8rem] md:text-[3.5rem] lg:text-[4rem] xl:text-[5rem] 2xl:text-[6rem] drop-shadow-sm transition-all duration-300 text-center max-w-4xl">
            {tx.heroH1}
          </span>
        </h1>
        <p class="mt-3 md:mt-4 text-xs sm:text-sm md:text-base text-slate-600 dark:text-slate-400 font-medium max-w-[90%] md:max-w-2xl mx-auto leading-relaxed tracking-wide text-center">
          {tx.heroSub}
        </p>
      </div>

      {/* Mobile chips */}
      <div class="flex-none w-full flex items-center justify-center gap-2 flex-wrap px-4 my-2 md:hidden">
        <span class="text-[9px] font-mono font-bold uppercase tracking-[0.15em] text-slate-600 dark:text-slate-400 px-3 py-1.5 rounded-full bg-white/70 dark:bg-slate-900/70 border border-slate-200/50 dark:border-slate-700/50 whitespace-nowrap">GTM Strategy</span>
        <span class="text-[9px] font-mono font-bold uppercase tracking-[0.15em] text-slate-600 dark:text-slate-400 px-3 py-1.5 rounded-full bg-white/70 dark:bg-slate-900/70 border border-slate-200/50 dark:border-slate-700/50 whitespace-nowrap">GA4 Analytics</span>
        <span class="text-[9px] font-mono font-bold uppercase tracking-[0.15em] text-slate-600 dark:text-slate-400 px-3 py-1.5 rounded-full bg-white/70 dark:bg-slate-900/70 border border-slate-200/50 dark:border-slate-700/50 whitespace-nowrap">Google Ads</span>
        <span class="text-[9px] font-mono font-bold uppercase tracking-[0.15em] text-slate-600 dark:text-slate-400 px-3 py-1.5 rounded-full bg-white/70 dark:bg-slate-900/70 border border-slate-200/50 dark:border-slate-700/50 whitespace-nowrap">AI Agents</span>
      </div>

      {/* Desktop orbit */}
      <div class="orbit-mobile-hidden flex-none w-full items-center justify-center relative perspective-container z-30 group cursor-default orbit-container-height my-0 md:my-1">
        <div class="orbit-axis w-0 h-0 relative scale-[0.6] sm:scale-[0.7] md:scale-[0.85] lg:scale-[1.0] xl:scale-100 origin-center transition-transform duration-500">
          {["GTM Strategy","GA4 Analytics","BigQuery","Looker Studio","AI Agents","Google Ads"].map((label, i) => (
            <div class="orbit-item" style={`transform: rotateY(${i*60}deg) translateZ(var(--orbit-radius))`}>
              <div class="orbit-content flex items-center gap-2 px-3 py-1.5 md:px-5 md:py-2.5 rounded-full bg-white/70 dark:bg-slate-900/70 backdrop-blur-md border border-slate-200/50 dark:border-slate-700/50 transition-colors" style={`animation-delay: -${i*4}s`}>
                <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-glow"></div>
                <span class="text-[10px] md:text-[11px] font-mono font-bold text-slate-700 dark:text-slate-200 uppercase tracking-[0.15em] whitespace-nowrap">{label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* CTA */}
      <div class="flex-none flex flex-col sm:flex-row gap-3 sm:gap-6 w-full sm:w-auto px-8 sm:px-0 pt-2 pb-2 md:pb-0 z-40">
        <a id="email-cta" class="btn-swiss group relative flex items-center justify-center gap-3 px-6 py-3.5 md:px-8 md:py-4 bg-primary text-white border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark shadow-inner-light hover:translate-x-[2px] hover:translate-y-[1px] hover:shadow-premium-hover dark:hover:shadow-premium-dark-hover" href="#" data-e="daniel" data-d="alphadigitalagency.id">
          <span class="material-symbols-outlined text-[18px] md:text-[20px]">mail</span>
          <span class="font-bold text-[11px] md:text-[13px] uppercase tracking-widest">{tx.ctaMail}</span>
        </a>
        <a class="btn-swiss group relative flex items-center justify-center gap-3 px-6 py-3.5 md:px-8 md:py-4 bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white text-charcoal dark:text-white shadow-premium dark:shadow-premium-dark shadow-inner-light hover:translate-x-[2px] hover:translate-y-[1px] hover:shadow-premium-hover dark:hover:shadow-premium-dark-hover" href="tel:0895368707977">
          <span class="material-symbols-outlined text-[18px] md:text-[20px] group-hover:text-primary transition-colors">call</span>
          <span class="font-bold text-[11px] md:text-[13px] uppercase tracking-widest">{tx.ctaPhone}</span>
        </a>
        <script is:inline>
          (function() { var el = document.getElementById('email-cta'); if (el) { el.href = 'mailto:' + el.dataset.e + '@' + el.dataset.d; } })();
        </script>
      </div>
    </div>

    <h2 class="relative z-10 w-full max-w-[1400px] px-4 mt-6 mb-2 text-center text-[11px] font-mono font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
      {tx.heroH2}
    </h2>
    <div class="relative z-10 w-full max-w-[1400px] px-4 mt-2 mb-4 grid grid-cols-2 md:grid-cols-4 gap-3">
      <a href={isEn ? "/en/services/foundation" : "/services/foundation"} class="bg-white/80 dark:bg-slate-900/80 border-2 border-charcoal dark:border-white p-4 card-swiss block text-left">
        <p class="text-[10px] font-mono uppercase tracking-widest text-primary mb-1">{tx.tier1Label}</p>
        <p class="font-bold text-charcoal dark:text-white text-sm">{tx.tier1Title}</p>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-1 leading-relaxed">{tx.tier1Desc}</p>
      </a>
      <a href={isEn ? "/en/services/growth" : "/services/growth"} class="bg-white/80 dark:bg-slate-900/80 border-2 border-charcoal dark:border-white p-4 card-swiss block text-left">
        <p class="text-[10px] font-mono uppercase tracking-widest text-primary mb-1">{tx.tier2Label}</p>
        <p class="font-bold text-charcoal dark:text-white text-sm">{tx.tier2Title}</p>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-1 leading-relaxed">{tx.tier2Desc}</p>
      </a>
      <a href={isEn ? "/en/services/authority" : "/services/authority"} class="bg-white/80 dark:bg-slate-900/80 border-2 border-charcoal dark:border-white p-4 card-swiss block text-left">
        <p class="text-[10px] font-mono uppercase tracking-widest text-primary mb-1">{tx.tier3Label}</p>
        <p class="font-bold text-charcoal dark:text-white text-sm">{tx.tier3Title}</p>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-1 leading-relaxed">{tx.tier3Desc}</p>
      </a>
      <a href={isEn ? "/en/services/booking-integration" : "/services/booking-integration"} class="bg-white/80 dark:bg-slate-900/80 border-2 border-charcoal dark:border-white p-4 card-swiss block text-left">
        <p class="text-[10px] font-mono uppercase tracking-widest text-primary mb-1">{tx.tier4Label}</p>
        <p class="font-bold text-charcoal dark:text-white text-sm">{tx.tier4Title}</p>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-1 leading-relaxed">{tx.tier4Desc}</p>
      </a>
    </div>

    {/* Marquee */}
    <div class="absolute bottom-0 w-full py-3 md:py-4 border-t border-slate-200 dark:border-slate-800 bg-background-light/80 dark:bg-background-dark/80 z-20">
      <div class="flex w-full overflow-hidden relative">
        <div class="absolute top-0 left-0 h-full w-20 md:w-32 bg-gradient-to-r from-background-light dark:from-background-dark to-transparent z-10 pointer-events-none"></div>
        <div class="absolute top-0 right-0 h-full w-20 md:w-32 bg-gradient-to-l from-background-light dark:from-background-dark to-transparent z-10 pointer-events-none"></div>
        <div class="flex animate-marquee-left whitespace-nowrap transition-opacity duration-300">
          {["Luxury Hospitality","Direct Booking","Revenue Growth","Data Science","Conversion Rate","Brand Equity"].map(label => (
            <div class="flex items-center gap-16 md:gap-20 px-8 md:px-10">
              <span class="text-[9px] md:text-[10px] font-bold uppercase tracking-[0.25em] text-slate-600 dark:text-slate-400">{label}</span>
              <span class="text-[9px] md:text-[10px] font-bold uppercase tracking-[0.25em] text-slate-600 dark:text-slate-400">{label}</span>
              <span class="text-[9px] md:text-[10px] font-bold uppercase tracking-[0.25em] text-slate-600 dark:text-slate-400">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Answer block */}
  <section class="max-w-4xl mx-auto py-12 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12">
      <h2 class="font-display font-bold text-xl md:text-2xl text-charcoal dark:text-white mb-4">{tx.answerH2}</h2>
      <p class="text-slate-700 dark:text-slate-300 text-sm md:text-base leading-relaxed">{tx.answerP}</p>
    </div>
  </section>

  {/* Comparison */}
  <section class="max-w-6xl mx-auto py-16 px-6 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-14 items-start">
      <div>
        <p class="text-[10px] font-mono font-bold uppercase tracking-[0.22em] text-primary mb-3">{tx.compareLabel}</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-charcoal dark:text-white leading-tight mb-5">{tx.compareH2}</h2>
        <div class="space-y-4 text-slate-700 dark:text-slate-300 text-sm md:text-base leading-relaxed">
          <p>{tx.compareP1}</p>
          <p>{tx.compareP2}</p>
          <p>{tx.compareP3}</p>
          <p>{tx.compareP4}</p>
        </div>
      </div>
      <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-6 md:p-8">
        <h3 class="font-display font-bold text-xl text-charcoal dark:text-white mb-5">{tx.compareBoxH3}</h3>
        <div class="space-y-5">
          {[{label: tx.creativeLabel, desc: tx.creativeDesc}, {label: tx.socialLabel, desc: tx.socialDesc}, {label: tx.webLabel, desc: tx.webDesc}].map(item => (
            <div>
              <p class="font-bold text-charcoal dark:text-white text-sm">{item.label}</p>
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
          <div class="border-t border-slate-200 dark:border-slate-700 pt-5">
            <p class="font-bold text-primary text-sm">{tx.alphaLabel}</p>
            <p class="text-slate-700 dark:text-slate-300 text-sm leading-relaxed">{tx.alphaDesc}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="max-w-4xl mx-auto py-16 px-6 md:px-12">
    <h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-8 text-center">{tx.faqTitle}</h2>
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12">
      <div class="space-y-6">
        {tx.faq.map((item) => (
          <div class="border-b border-slate-200 dark:border-slate-700 pb-6 last:border-0 last:pb-0">
            <h3 class="font-bold text-charcoal dark:text-white mb-2">{item.q}</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-8 text-center">
      <a href="mailto:daniel@alphadigitalagency.id" class="btn-swiss inline-flex items-center gap-2 px-8 py-4 bg-primary text-white border-2 border-charcoal shadow-premium font-bold text-sm uppercase tracking-widest">
        <span class="material-symbols-outlined">mail</span>
        {tx.ctaMail}
      </a>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-6 text-center">
      <Fragment set:html={tx.author} />
    </p>
  </section>
</SwissLayout>
