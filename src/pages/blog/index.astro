---
import { Image } from "astro:assets";
import SwissLayout from "../../components/SwissLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_URL } from "../../consts";

interface Post {
	id: number;
	slug: string;
	title: string;
	description: string;
	pub_date: string;
	hero_image: string;
	hero_alt?: string | null;
}

const { env } = Astro.locals.runtime;
if (!env || !env.DB) {
	console.error("DB binding missing");
	throw new Error("DB binding missing");
}

// Locale-aware blog listing (2026-08-18, Daniel bug report: "mode Indonesia
// tapi blog English"). /en/blog is served through the worker /en/* rewrite with
// X-Locale: en; languages pair via the -en slug suffix convention.
const pageLocale = ((Astro.locals as any).locale as string) || "id";
const hasEnPrefix =
	Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
const isEn = pageLocale === "en" || hasEnPrefix;

const { results: posts } = await env.DB.prepare(
	`SELECT * FROM posts WHERE is_published = 1 AND slug ${isEn ? "LIKE '%-en'" : "NOT LIKE '%-en'"} ORDER BY pub_date DESC`,
).all<Post>();

// Pillar hubs for the topical nav (KG-SEO v3 Gap #17) — data-driven from
// content_pillars so a new pillar needs zero code.
const { results: pillars } = await env.DB.prepare(
	"SELECT pillar_id, title FROM content_pillars ORDER BY title",
).all<{ pillar_id: string; title: string }>();

const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/*.{jpeg,jpg,png,gif}",
	{ eager: true },
);

// Blog index CollectionPage schema (Gap #13) — the index previously emitted no
// Blog/CollectionPage/ItemList, leaving the listing graph-blind. ItemList is
// populated from the published posts (latest 10, no-slash URLs). Passed as
// mainEntity so SeoGraph normalizes it into the @graph (isPartOf → #webpage).
// Distinct @id (#blog) — never collides with the auto WebPage node's #webpage.
const blogIndexURL = isEn ? `${SITE_URL}/en/blog` : `${SITE_URL}/blog`;
const blogIndexDescription = isEn
	? "Google Ads strategy, hospitality SEO, booking engines, and AI agents for hotels and villas in Bali — straight from practitioners."
	: "Strategi Google Ads, SEO hospitality, booking engine, dan AI agent untuk hotel dan villa di Bali — langsung dari praktisi.";
const blogIndexLD = {
	"@type": ["Blog", "CollectionPage"],
	"@id": `${blogIndexURL}/#blog`,
	name: "Blog | Alpha Digital Agency",
	description: blogIndexDescription,
	url: blogIndexURL,
	mainEntity: {
		"@type": "ItemList",
		itemListElement: posts.slice(0, 10).map((post, i) => ({
			"@type": "ListItem",
			position: i + 1,
			url: `${SITE_URL}/blog/${post.slug}`,
			name: post.title,
		})),
	},
};
---

<SwissLayout title="Blog | Alpha Digital Agency" currentPage="blog" description={blogIndexDescription} mainEntity={blogIndexLD}>
	<!-- Hero Section -->
	<section class="max-w-6xl mx-auto mb-16 md:mb-24 px-6 md:px-12">
		<h1
			class="font-display font-extrabold text-charcoal dark:text-white leading-display tracking-tightest text-center"
		>
			<span
				class="text-[2.5rem] sm:text-[4rem] md:text-[5rem] lg:text-[6rem] block"
			>
				{isEn ? (
					<>
						Insights<span class="text-primary">&</span>Stories
					</>
				) : (
					<>
						Wawasan<span class="text-primary">&</span>Cerita
					</>
				)}
			</span>
		</h1>
		<p
			class="mt-4 md:mt-6 text-sm md:text-base text-slate-600 dark:text-slate-400 font-medium max-w-xl mx-auto text-center leading-relaxed tracking-wide"
		>
			{isEn
				? "Digital marketing expertise for hotels. We decode data, design luxury experiences, and drive direct bookings."
				: "Keahlian digital marketing untuk hotel dan villa di Bali. Kami baca data, rancang pengalaman tamu, dan dorong direct booking."}
		</p>
	</section>

	<!-- Pillar hub navigation (KG-SEO v3 Gap #17 — evergreen topical hubs) -->
	{pillars.length > 0 && (
		<nav class="max-w-6xl mx-auto pb-10 px-6 md:px-12" aria-label="Topik blog">
			<div class="flex flex-wrap gap-3 justify-center">
				{pillars.map((p) => (
					<a
						href={`${isEn ? "/en" : ""}/blog/pillar/${p.pillar_id}`}
						class="border-2 border-charcoal dark:border-white px-4 py-2 text-xs font-bold uppercase tracking-widest hover:bg-primary hover:text-white hover:border-primary transition-colors"
					>
						{p.title}
					</a>
				))}
			</div>
		</nav>
	)}

	<!-- Blog Posts Grid -->
	<section class="max-w-6xl mx-auto pb-16 px-6 md:px-12">
		{
			posts.length === 0 ? (
				<div class="text-center py-16">
					<p class="text-slate-500 text-lg">
						{isEn ? "No posts published yet." : "Belum ada artikel."}
					</p>
				</div>
			) : (
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{posts.map((post, index) => {
						const imagePath = post.hero_image?.replace(
							"../../",
							"/src/",
						);
						const imageModule = imagePath
							? images[imagePath]
							: null;
						const isPublicImage = post.hero_image?.startsWith("/images/");
						const isFeatured = index === 0;

						return (
							<a
								href={`/blog/${post.slug}`}
								class:list={[
									"card-swiss block bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark overflow-hidden group",
									{
										"md:col-span-2 lg:col-span-3":
											isFeatured,
									},
								]}
							>
								{post.hero_image && (imageModule || isPublicImage) && (
									<div class="overflow-hidden">
										{isPublicImage ? (
											<img
												src={post.hero_image}
												alt={post.hero_alt || post.title}
												class:list={[
													"w-full object-cover transition-transform duration-300 group-hover:scale-105",
													{
														"h-64 md:h-80 lg:h-96": isFeatured,
														"h-48 md:h-56": !isFeatured,
													},
												]}
											/>
										) : (
											<Image
												width={isFeatured ? 1200 : 600}
												height={isFeatured ? 500 : 300}
												src={imageModule.default}
												alt={post.hero_alt || post.title}
												class:list={[
													"w-full object-cover transition-transform duration-300 group-hover:scale-105",
													{
														"h-64 md:h-80 lg:h-96":
															isFeatured,
														"h-48 md:h-56": !isFeatured,
													},
												]}
											/>
										)}
									</div>
								)}
								<div class="p-6 md:p-8">
									<p class="text-[10px] font-mono font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mb-3">
										<FormattedDate
											date={new Date(post.pub_date)}
										/>
									</p>
									<h2
										class:list={[
											"font-display font-bold text-charcoal dark:text-white leading-tight mb-3 group-hover:text-primary transition-colors",
											{
												"text-2xl md:text-3xl lg:text-4xl":
													isFeatured,
												"text-xl md:text-2xl":
													!isFeatured,
											},
										]}
									>
										{post.title}
									</h2>
									<p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed line-clamp-2">
										{post.description}
									</p>
									<div class="mt-4 flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-widest">
										<span>{isEn ? "Read Article" : "Baca Artikel"}</span>
										<span class="material-symbols-outlined text-sm">
											arrow_forward
										</span>
									</div>
								</div>
							</a>
						);
					})}
				</div>
			)
		}
	</section>
</SwissLayout>
