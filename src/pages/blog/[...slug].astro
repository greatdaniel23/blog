---
import { Image } from "astro:assets";
import { marked } from "marked";
import SwissLayout from "../../components/SwissLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_URL } from "../../consts";

const { slug } = Astro.params;
const { env } = Astro.locals.runtime;

interface Post {
	id: number;
	slug: string;
	title: string;
	description: string;
	content: string;
	pub_date: string;
	hero_image: string;
	updated_at: string;
	faq?: string | null;
	howto_steps?: string | null;
	// KG-SEO v3 dynamic-node taxonomy (migration 0009) + authors FK (0013).
	pillar_id?: string | null;
	node_type?: string | null;
	upward_links?: string | null;
	author_id?: number | null;
	/** Free-text legacy author — kept for display fallback pre-0013. */
	author?: string | null;
	/** Resolved author name via authors table JOIN (0013). */
	author_name?: string | null;
}

// Authors JOIN (migration 0013). Fail-degrade: if the migration hasn't been
// applied yet (author_id column absent), fall back to the legacy plain query —
// the page must NEVER 500 over an unapplied migration.
let post: Post | null = null;
try {
	post = await env.DB.prepare(
		`SELECT p.*, a.name AS author_name
		 FROM posts p
		 LEFT JOIN authors a ON p.author_id = a.id
		 WHERE p.slug = ?`,
	)
		.bind(slug)
		.first<Post>();
} catch {
	post = await env.DB.prepare("SELECT * FROM posts WHERE slug = ?")
		.bind(slug)
		.first<Post>();
}

// Increment view count (fire-and-forget via waitUntil, don't block render).
// ctx is the CF ExecutionContext from the Astro Cloudflare adapter runtime.
if (post) {
	Astro.locals.runtime.ctx.waitUntil(
		env.DB.prepare("UPDATE posts SET view_count = view_count + 1 WHERE id = ?")
			.bind(post.id)
			.run(),
	);
}

const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/*.{jpeg,jpg,png,gif}",
	{ eager: true },
);

if (!post) {
	// Real 404 (not a soft-302 redirect): set the wire status to 404 and render
	// the not-found view. CF Pages / crawlers see HTTP 404, preserving crawl budget.
	Astro.response.status = 404;
}

// Convert D1 timestamps ("YYYY-MM-DD HH:MM:SS", date-only "YYYY-MM-DD") to ISO
// 8601 with the Bali offset. Idempotent: already-ISO input (has 'T' or an offset)
// is returned unchanged.
function toISO(d: string | null | undefined): string | undefined {
	if (!d) return undefined;
	const s = d.trim();
	if (s === "") return undefined;
	if (s.includes("T") || /[+\-]\d{2}:\d{2}$/.test(s) || s.endsWith("Z")) return s;
	// Date-only "YYYY-MM-DD" → need time component
	if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s + "T08:00:00+08:00";
	// "YYYY-MM-DD HH:MM:SS" → add +08:00 offset
	return s.replace(" ", "T") + "+08:00";
}

// Strip any embedded scripts from the post body. Post markdown must never carry
// <script> — an embedded application/ld+json Article block was producing a second,
// future-dated Article entity on 2 posts (P0a). Belt-and-suspenders: even after the
// D1 content is cleaned, the template refuses to render body scripts.
const rawContent = post ? String(marked.parse(post.content)) : "";
const content = rawContent
	.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "")
	.replace(/<h1(\s[^>]*)?>/gi, "<h2$1>")
	.replace(/<\/h1>/gi, "</h2>");

const seoTitleBySlug: Record<string, string> = {
	"digital-marketing-agency-bali-hospitality": "Cara Memilih Digital Marketing Agency Bali untuk Hotel",
	"google-ads-agency-bali-hotel-villa": "Google Ads Agency Bali for Hotels | Alpha Digital",
	"seo-untuk-hotel-villa-bali": "SEO untuk Hotel dan Vila Bali | Alpha Digital",
	"digital-agency-bali-hotel-villa": "Digital Marketing Bali untuk Hotel | Alpha Digital",
	"booking-engine-adalah": "Booking Engine Adalah untuk Hotel Bali | Alpha Digital",
	"google-tag-manager-adalah": "Google Tag Manager untuk Hotel | Alpha Digital",
	"google-analytics-4-adalah": "Google Analytics 4 untuk Hotel | Alpha Digital",
	"cara-tracking-konversi-booking-villa-bali": "Tracking Konversi Booking Villa Bali | Alpha Digital",
	"direct-booking-vs-ota-cost-math-villa-bali": "Direct Booking vs OTA Villa Bali | Alpha Digital",
	"era-baru-google-ads-mengapa-alpha-digital-agency-memilih-integrasi-llm-anthropic-di-2026": "Google Ads + LLM untuk Hotel | Alpha Digital",
	"esensi-digital-marketing-dan-strategi-distribusi-informasi": "Strategi Digital Marketing Hotel | Alpha Digital",
	"revolusi-reservasi-hotel-ai-agent-booking-engine": "AI Agent + Booking Engine Hotel | Alpha Digital",
	"cara-meningkatkan-direct-booking-dari-website-sampai-tracking": "Cara Meningkatkan Direct Booking Hotel | Alpha Digital",
};

function compactTitle(title: string, slug: string): string {
	if (seoTitleBySlug[slug]) return seoTitleBySlug[slug];
	const suffix = " | Alpha Digital";
	if (title.length + suffix.length <= 60) return `${title}${suffix}`;
	return `${title.slice(0, 60 - suffix.length - 3).trim()}...${suffix}`;
}

function compactDescription(description: string): string {
	if (description.length <= 160) return description;
	return `${description.slice(0, 157).replace(/\s+\S*$/, "").trim()}...`;
}

// Resolve hero image URL for structured data — use absolute URL if possible.
const isPublicHero = post?.hero_image?.startsWith("/images/");
const isR2Hero = post?.hero_image?.startsWith("https://");
const heroImageSrc = isPublicHero || isR2Hero
	? post?.hero_image
	: post?.hero_image
		? images[post.hero_image.replace("../../", "/src/")]?.default?.src
		: undefined;
const heroImageAbsolute = heroImageSrc
	? new URL(heroImageSrc, SITE_URL).toString()
	: undefined;
const schemaImageAbsolute = heroImageAbsolute ?? `${SITE_URL}/images/og-alpha-default.png`;

// Canonical post URL — NO trailing slash (ALPHA decision: no-slash is the standard;
// matches sitemap + page canonical). mainEntityOfPage + breadcrumb must agree.
const postURL = post ? `${SITE_URL}/blog/${post.slug}` : "";

// ISO-8601 dates with +08:00 offset (P1c) — used in schema AND article:* meta.
const publishedISO = toISO(post?.pub_date);
const modifiedISO = post && post.updated_at && post.updated_at !== post.pub_date
	? toISO(post.updated_at)
	: publishedISO;

const seoTitle = post ? compactTitle(post.title, post.slug) : "";
const seoDescription = post ? compactDescription(post.description ?? "") : "";

// Upward link edges (KG-SEO v3 Gap #8, spec 07 §3C) — entity-descriptive
// anchors, 1–3 per post, matched to the post's content pillar. Dynamic posts
// feed authority to static authority sinks; anchors use the approved entity
// phrases (never "klik di sini" / generic labels).
interface UpwardLink {
	href: string;
	label: string;
	desc: string;
}

// Approved per-pillar targets. Primary = the pillar's own static authority
// sink; digital-marketing-bali feeds the brand root + the SEO/data offering.
const PILLAR_UPWARD_TARGETS: Record<string, UpwardLink[]> = {
	"google-ads": [
		{
			href: "/services/google-ads",
			label: "Google Ads Specialist Bali",
			desc: "Google Ads management terintegrasi GA4, GTM, dan booking engine untuk hotel & villa di Bali.",
		},
	],
	"booking-engine": [
		{
			href: "/services/booking-engine",
			label: "Booking Engine Villa Bali",
			desc: "Booking engine direct reservation untuk kurangi ketergantungan OTA dan kuasai data tamu.",
		},
	],
	"ai-agent": [
		{
			href: "/services/ai-agent",
			label: "AI Chatbot Villa Bali",
			desc: "Asisten AI yang menjawab calon tamu 24/7 dan menjaga inquiry tetap bergerak.",
		},
	],
	"digital-marketing-for-hotel": [
		{
			href: "/services/google-ads",
			label: "Google Ads Specialist Bali",
			desc: "Google Ads management terintegrasi GA4, GTM, dan booking engine untuk hotel & villa di Bali.",
		},
		{
			href: "/services/booking-engine",
			label: "Booking Engine Villa Bali",
			desc: "Booking engine direct reservation untuk kurangi ketergantungan OTA dan kuasai data tamu.",
		},
	],
	"digital-marketing-bali": [
		{
			href: "/",
			label: "Digital Marketing Agency Bali",
			desc: "Alpha Digital Agency — Google Ads, AI, dan digital transformation untuk bisnis hospitality di Bali.",
		},
		{
			href: "/services/foundation",
			label: "SEO & Data Tracking Bali",
			desc: "Fundamental SEO, GA4, GTM, dan Search Console untuk hotel & villa di Bali.",
		},
	],
};

// Defensive fallback when a post has no pillar (should not happen post-0010).
const FALLBACK_UPWARD_LINK: UpwardLink = PILLAR_UPWARD_TARGETS["digital-marketing-bali"][0];

// Internal-only href guard: relative no-slash paths only. Rejects absolute /
// protocol-relative URLs so CMS-provided upward_links can never open a redirect
// or leak off-domain (WARDEN open-redirect pattern).
function isInternalPath(href: string): boolean {
	return (
		typeof href === "string" &&
		href.startsWith("/") &&
		!href.startsWith("//") &&
		!href.includes(":")
	);
}

// Resolve the 1–3 upward links for this post:
//   1. post.upward_links JSON (CMS, format from migration 0009:
//      [{ target_static_url, anchor_text, relevance_score }]) — validated + capped.
//   2. else entity-matched module derived from the post's pillar.
function resolveUpwardLinks(post: Post): UpwardLink[] {
	if (post.upward_links && post.upward_links.trim() !== "") {
		try {
			const parsed: unknown = JSON.parse(post.upward_links);
			if (Array.isArray(parsed)) {
				const links = parsed
					.map((item) => {
						const row = item as Record<string, unknown>;
						const href = String(row.target_static_url ?? row.href ?? "");
						const label = String(row.anchor_text ?? row.label ?? "").trim();
						if (!isInternalPath(href) || !label) return null;
						return { href, label, desc: String(row.desc ?? "") } as UpwardLink;
					})
					.filter((l): l is UpwardLink => l !== null)
					.slice(0, 3);
				if (links.length > 0) return links;
			}
		} catch {
			// malformed JSON — fall through to pillar derivation
		}
	}
	const derived = post.pillar_id ? PILLAR_UPWARD_TARGETS[post.pillar_id] : undefined;
	return derived && derived.length > 0 ? derived : [FALLBACK_UPWARD_LINK];
}

const relatedSEOLinks = post ? resolveUpwardLinks(post) : [];

// Vector-driven "Artikel Terkait" module (Phase 3, audit §4.6) — semantic
// neighbors from kg-blog-index. Inline embed+query: this SSR worker holds the
// AI + VECTORIZE bindings, so the render path needs no HTTP hop and no extra
// auth surface. Same rerank rules as the blog-agent side (language hard-filter,
// self/EN-twin exclusion by slug, pillar ±0.05 boost, floor 0.75, top-3 cap).
// Degrade: any failure → empty list → module hidden → page renders exactly as
// before (the pillar-based upward-links module above is the fallback).
interface RelatedArticle {
	slug: string;
	title: string;
	description: string;
	score: number;
}

const KG_FLOOR = 0.75;
const KG_TOP_N = 3;
const KG_QUERY_TOP_K = 20;
const KG_PILLAR_BOOST = 0.05;

async function embedBGE(ai: unknown, text: string): Promise<number[]> {
	const emb = await (ai as Ai).run("@cf/baai/bge-base-en-v1.5", { text: [text] });
	// Same response handling as /api/kg routes: bge returns { data: [[...]] },
	// some models { data: [{ embedding: [...] }] } — handle both.
	const raw = emb as { data?: (number[] | { embedding?: number[] })[] };
	const first = raw.data?.[0];
	const values = Array.isArray(first) ? first : first?.embedding;
	if (!values) throw new Error("no embedding returned");
	return values;
}

const relatedArticles: RelatedArticle[] = [];
if (post) {
	try {
		const language = post.slug.endsWith("-en") ? "en" : "id";
		const queryText = `${post.title} ${post.description ?? ""}`.trim();
		const vector = await embedBGE(env.AI, queryText);
		const res = await (env.VECTORIZE as VectorizeIndex).query(vector, {
			topK: KG_QUERY_TOP_K,
			returnMetadata: "all",
		});
		const twinSlug = post.slug.endsWith("-en") ? post.slug.slice(0, -3) : `${post.slug}-en`;
		const hits: RelatedArticle[] = [];
		for (const m of res.matches ?? []) {
			const md = m.metadata ?? {};
			// Old chunks lack a language field (pre-re-sync) — treat missing as 'id'.
			if ((md.language ?? "id") !== language) continue;
			const slug = String(md.slug ?? md.doc_id ?? "").replace(/^blog_/, "");
			if (!slug || slug === post.slug || slug === twinSlug) continue;
			let score = m.score;
			const pillar = String(md.entity_tags ?? "");
			if (post.pillar_id && pillar === post.pillar_id) score += KG_PILLAR_BOOST;
			else if (post.pillar_id && pillar !== "unclassified") score -= KG_PILLAR_BOOST;
			if (score < KG_FLOOR) continue;
			hits.push({
				slug,
				title: String(md.title ?? slug),
				description: String(md.description ?? ""),
				score,
			});
		}
		hits.sort((a, b) => b.score - a.score);
		relatedArticles.push(...hits.slice(0, KG_TOP_N));
	} catch {
		// degrade: no related module on any query failure
	}
}

// Pillar title map for the module heading + hub link (mirrors content_pillars;
// avoids an extra query per post).
const PILLAR_TITLES: Record<string, string> = {
	"google-ads": "Google Ads",
	"booking-engine": "Booking Engine",
	"ai-agent": "AI Agent",
	"digital-marketing-for-hotel": "Digital Marketing for Hotel",
	"digital-marketing-bali": "Digital Marketing Bali",
};
const pillarTitle = post?.pillar_id ? PILLAR_TITLES[post.pillar_id] : null;

// Author attribution (KG-SEO v3 Gap #10) — standardized from the authors FK:
//   - Daniel Santoso            → Person (no-slash profile URL)
//   - any other / NULL author   → Organization (#organization @id ref)
// Resolved name comes from the authors table; pre-0013 rows fall back to the
// legacy free-text column.
const authorResolvedName =
	post?.author_name ?? post?.author ?? null;
const isPersonAuthor =
	authorResolvedName === "Daniel Santoso";
const authorLD = isPersonAuthor
	? {
			"@type": "Person",
			name: "Daniel Santoso",
			url: `${SITE_URL}/daniel-santoso`,
		}
	: {
			"@type": "Organization",
			"@id": `${SITE_URL}/#organization`,
		};
const authorDisplayName = authorResolvedName || "Alpha Digital Agency";

const blogPostingLD = post ? {
	"@context": "https://schema.org",
	"@type": ["BlogPosting", "Article"],
	headline: post.title,
	description: post.description ?? "",
	datePublished: publishedISO,
	dateModified: modifiedISO,
	author: authorLD,
	publisher: {
		"@id": `${SITE_URL}/#organization`,
	},
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": postURL,
	},
	image: {
		"@type": "ImageObject",
		url: schemaImageAbsolute,
	},
} : null;

// BreadcrumbList now built as breadcrumbsProp (SeoGraph props) below — the old
// breadcrumbLD const was replaced by the unified @graph (KG-SEO v3 Phase A).

// FAQPage schema — only emitted when post.faq is a non-empty JSON string.
// Data feeds SeoGraph's FAQPage node inside the unified @graph (KG-SEO v3 Phase A).
let faqProp: { q: string; a: string }[] | null = null;
if (post?.faq && post.faq.trim() !== "") {
	try {
		const faqItems: Array<{ question: string; answer: string }> = JSON.parse(post.faq);
		if (Array.isArray(faqItems) && faqItems.length > 0) {
			faqProp = faqItems.map((item) => ({ q: item.question, a: item.answer }));
		}
	} catch {
		// parse failure — skip silently
	}
}

// HowTo schema — only emitted when post.howto_steps is a non-empty JSON string.
// Data feeds SeoGraph's HowTo node inside the unified @graph (KG-SEO v3 Phase A).
let howtoProp: { name?: string; steps: Array<{ name: string; text: string }> } | null = null;
if (post?.howto_steps && post.howto_steps.trim() !== "") {
	try {
		const howtoData: { name?: string; steps: Array<{ name: string; text: string }> } =
			JSON.parse(post.howto_steps);
		if (Array.isArray(howtoData.steps) && howtoData.steps.length > 0) {
			howtoProp = { name: howtoData.name ?? post.title, steps: howtoData.steps };
		}
	} catch {
		// parse failure — skip silently
	}
}

// Breadcrumbs for the unified @graph (SeoGraph BreadcrumbList node) — all
// items in no-slash canonical form (KG-SEO v3 Gap #11: zero redirect hops,
// @id must match the page canonicals).
const breadcrumbsProp = post
	? [
			{ name: "Home", url: "/" },
			{ name: "Blog", url: "/blog" },
			{ name: post.title, url: postURL },
		]
	: null;

// WebPage.about — entity topics from the post's content pillar (Gap #6).
// Wikidata-verified QIDs only; posts without a pillar emit no about.
const PILLAR_ABOUT: Record<string, { name: string; sameAs: string }> = {
	"digital-marketing-bali": { name: "Digital Marketing", sameAs: "https://www.wikidata.org/wiki/Q1323528" },
	"google-ads": { name: "Google Ads", sameAs: "https://www.wikidata.org/wiki/Q271982" },
	"digital-marketing-for-hotel": { name: "Hotel", sameAs: "https://www.wikidata.org/wiki/Q27686" },
	"booking-engine": { name: "Hotel", sameAs: "https://www.wikidata.org/wiki/Q27686" },
	"ai-agent": { name: "Artificial Intelligence", sameAs: "https://www.wikidata.org/wiki/Q11660" },
};
const aboutProp = post?.pillar_id ? [PILLAR_ABOUT[post.pillar_id]].filter(Boolean) : null;
---

{post ? (
<SwissLayout
	title={seoTitle}
	description={seoDescription}
	currentPage="blog"
	image={heroImageAbsolute}
	article={{ publishedTime: publishedISO, modifiedTime: modifiedISO }}
	mainEntity={blogPostingLD}
	breadcrumbs={breadcrumbsProp}
	faq={faqProp}
	howto={howtoProp}
	about={aboutProp}
>
	<article class="max-w-4xl mx-auto pb-16 px-6 md:px-12">
		<!-- Hero Image -->
		{
			post.hero_image && (isPublicHero || isR2Hero || images[post.hero_image.replace("../../", "/src/")]) && (
				<div class="mb-8 overflow-hidden border-2 border-charcoal shadow-premium">
					{isPublicHero || isR2Hero ? (
						<img
							src={post.hero_image}
							alt={post.title}
							class="w-full h-64 md:h-96 object-cover"
						/>
					) : (
						<Image
							width={1200}
							height={600}
							src={
								images[
									post.hero_image.replace("../../", "/src/")
								].default
							}
							alt={post.title}
							class="w-full h-64 md:h-96 object-cover"
						/>
					)}
				</div>
			)
		}

		<!-- Article Header -->
		<header class="mb-8 text-center">
			<!-- E-E-A-T byline: author + publish date above the fold. Author from
			     the authors FK (0013); Person rows link no-slash to the profile. -->
			<p class="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-[0.2em] mb-1">
				Ditulis oleh{" "}
				{isPersonAuthor ? (
					<a href="/daniel-santoso" class="text-primary hover:underline">Daniel Santoso</a>
				) : (
					<span class="text-charcoal dark:text-white">{authorDisplayName}</span>
				)}
				<span class="text-slate-400 mx-2">·</span>
				<FormattedDate date={new Date(post.pub_date)} />
				{
					post.updated_at && post.updated_at !== post.pub_date && (
						<span class="text-slate-400 ml-2">
							· Diperbarui{" "}
							<FormattedDate date={new Date(post.updated_at)} />
						</span>
					)
				}
			</p>
			<h1
				class="font-display font-extrabold text-3xl md:text-4xl lg:text-5xl text-charcoal dark:text-white leading-tight mb-4 mt-4"
			>
				{post.title}
			</h1>
			<p
				class="text-slate-600 dark:text-slate-400 text-lg max-w-2xl mx-auto"
			>
				{post.description}
			</p>
		</header>

		<hr class="border-slate-200 dark:border-slate-700 mb-8" />

		<!-- Article Content -->
		<div
			class="prose prose-lg max-w-none
				prose-headings:font-display prose-headings:font-bold prose-headings:text-charcoal dark:prose-headings:text-white
				prose-p:text-slate-600 dark:prose-p:text-slate-400 prose-p:leading-relaxed
				prose-a:text-primary prose-a:no-underline hover:prose-a:underline
				prose-strong:text-charcoal dark:prose-strong:text-white
				prose-code:bg-slate-100 dark:prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-normal
				prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:pl-4 prose-blockquote:italic
				prose-img:rounded prose-img:border-2 prose-img:border-charcoal prose-img:shadow-premium
				prose-ul:text-slate-600 dark:prose-ul:text-slate-400
				prose-ol:text-slate-600 dark:prose-ol:text-slate-400
				prose-li:marker:text-primary"
			set:html={content}
		/>

		<section class="mt-12 border-2 border-charcoal dark:border-white bg-white dark:bg-slate-900 shadow-premium dark:shadow-premium-dark p-6 md:p-8">
			<p class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-primary mb-3">
				Related Alpha Digital Pages
			</p>
			<h2 class="font-display font-bold text-2xl text-charcoal dark:text-white mb-5">
				Lanjutkan ke topik {pillarTitle ?? "digital marketing Bali"}
			</h2>
			<div class:list={[
				"grid gap-4",
				relatedSEOLinks.length === 1
					? "grid-cols-1 md:grid-cols-1 max-w-md"
					: "grid-cols-1 md:grid-cols-2",
			]}>
				{relatedSEOLinks.map((link) => (
					<a href={link.href} class="group border border-slate-200 dark:border-slate-700 p-4 hover:border-primary transition-colors">
						<span class="font-bold text-charcoal dark:text-white group-hover:text-primary transition-colors">
							{link.label}
						</span>
						<span class="block text-sm text-slate-600 dark:text-slate-400 leading-relaxed mt-1">
							{link.desc}
						</span>
					</a>
				))}
			</div>
			{pillarTitle && (
				<a
					href={`/blog/pillar/${post.pillar_id}`}
					class="inline-flex items-center gap-2 mt-5 text-sm font-bold text-primary hover:underline"
				>
					Jelajahi semua artikel topik {pillarTitle}
					<span class="material-symbols-outlined text-sm">arrow_forward</span>
				</a>
			)}
		</section>

		{
			relatedArticles.length > 0 && (
				<section class="mt-12 border-2 border-charcoal dark:border-white bg-white dark:bg-slate-900 shadow-premium dark:shadow-premium-dark p-6 md:p-8">
					<p class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-primary mb-3">
						Related Articles
					</p>
					<h2 class="font-display font-bold text-2xl text-charcoal dark:text-white mb-5">
						Artikel Terkait
					</h2>
					<div class="grid gap-4 grid-cols-1 md:grid-cols-3">
						{relatedArticles.map((a) => (
							<a
								href={`/blog/${a.slug}`}
								class="group border border-slate-200 dark:border-slate-700 p-4 hover:border-primary transition-colors"
							>
								<span class="font-bold text-charcoal dark:text-white group-hover:text-primary transition-colors">
									{a.title}
								</span>
								{a.description && (
									<span class="block text-sm text-slate-600 dark:text-slate-400 leading-relaxed mt-1 line-clamp-2">
										{a.description}
									</span>
								)}
							</a>
						))}
					</div>
				</section>
			)
		}

		<!-- Back to Blog -->
		<div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-700">
			<a
				href="/blog"
				class="btn-swiss inline-flex items-center gap-2 px-6 py-3 bg-charcoal dark:bg-white text-white dark:text-charcoal border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark font-bold text-sm uppercase tracking-widest"
			>
				<span class="material-symbols-outlined">arrow_back</span>
				Back to Blog
			</a>
		</div>
	</article>
</SwissLayout>
) : (
<SwissLayout title="Artikel Tidak Ditemukan | Alpha Digital Agency" currentPage="blog">
	<section class="max-w-2xl mx-auto px-6 md:px-12 text-center py-16">
		<div class="font-display font-extrabold text-[6rem] md:text-[9rem] leading-none text-primary mb-4">404</div>
		<h1 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white mb-4">Artikel Tidak Ditemukan</h1>
		<p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-8 max-w-md mx-auto">
			Artikel yang Anda cari mungkin telah dipindahkan, dihapus, atau tidak pernah ada.
		</p>
		<a href="/blog" class="btn-swiss inline-flex items-center gap-2 px-6 py-3.5 bg-primary text-white border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark font-bold text-sm uppercase tracking-widest">
			<span class="material-symbols-outlined">arrow_back</span>
			Kembali ke Blog
		</a>
	</section>
</SwissLayout>
)}
