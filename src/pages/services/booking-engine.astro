                                <div>
                                    <strong
                                        class="block text-emerald-900 dark:text-white"
                                        >Edge Performance</strong
                                    >
                                    <span class="text-xs opacity-80"
                                        >Hosted on Cloudflare for global low
                                        latency & Mobile-First UX.</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-3">
                        <a
