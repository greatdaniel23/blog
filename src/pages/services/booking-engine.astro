                            <span class="material-symbols-outlined">chat</span>
                            Konsultasi via WhatsApp
                        </a>
                        <a
                            href="mailto:daniel@alphadigitalagency.id?subject=request%20install"
                            class="btn-swiss inline-flex items-center gap-2 px-8 py-3.5 bg-white dark:bg-slate-900 text-charcoal dark:text-white border-2 border-charcoal dark:border-white shadow-premium font-bold text-sm uppercase tracking-widest"
                        >
                            <span class="material-symbols-outlined">mail</span>
                            Request to Use
                        </a>
                    </div>

                    <div
                        class="mt-12 flex items-center gap-4 text-sm text-emerald-mid dark:text-gray-400"
