                                >50+ Hotel Partners</span
                            >
                        </p>
                    </div>
                </div>
            </div>

            <!-- Right Content: The Product Visual -->
            <div
                class="relative w-full lg:w-1/2 bg-gradient-to-br from-emerald-50 to-green-100 dark:from-gray-800 dark:to-background-dark flex items-center justify-center p-8 lg:p-16 overflow-hidden"
