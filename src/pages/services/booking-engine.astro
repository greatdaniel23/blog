                                    </div>

                                    <div class="bg-white rounded-lg mb-8">
                                        <div
                                            class="grid grid-cols-2 gap-3 mb-3"
                                        >
                                            <div
                                                class="border border-gray-200 rounded p-2 bg-white hover:border-primary transition-colors cursor-pointer"
                                            >
                                                <label
