---
// Landing page using SwissLayout for nav & SEO consistency
import SwissLayout from "../../components/SwissLayout.astro";
import FeaturedResources from "../../components/FeaturedResources.astro";
import { WA_JASA } from "../../lib/linkbio";

const SITE_URL = "https://alphadigitalagency.id";
const PAGE_URL = `${SITE_URL}/services/booking-engine`;

// Unified @graph page nodes (KG-SEO v3 Phase A + B) — sitewide nodes (Organization/
// LocalBusiness/ProfessionalService/WebSite) come from SeoGraph itself.
const mainEntity = {
    "@type": "Service",
    "@id": `${PAGE_URL}/#service`,
    "name": "Direct Booking Engine untuk Vila dan Hotel di Bali",
    "provider": {
        "@id": "https://alphadigitalagency.id/#organization"
    },
    "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Bali",
        "sameAs": "https://www.wikidata.org/wiki/Q3125978"
    },
    "description": "Direct booking engine untuk vila dan hotel Bali — edge-rendered, Google Hotel Center ready, Core Web Vitals optimized. Kurangi ketergantungan OTA.",
    "serviceType": "Booking Engine Integration",
    "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Paket Booking Engine Villa",
        "itemListElement": [
            { "@type": "Offer", "name": "Booking Engine Installation & Setup", "priceCurrency": "IDR" },
            { "@type": "Offer", "name": "Booking Engine + Conversion Tracking Bundle", "priceCurrency": "IDR" }
        ]
    },
    "url": PAGE_URL
};

const breadcrumbs = [
    { "name": "Home", "url": "/" },
    { "name": "Booking Engine", "url": PAGE_URL }
];

const about = [
    { "name": "Hotel", "sameAs": "https://www.wikidata.org/wiki/Q27686" },
];
---

<SwissLayout
    title="Direct Booking Engine — Alpha Digital Agency Indonesia"
    description="Direct booking engine for Bali villas and hotels. Edge-rendered, Google Hotel Center ready, Core Web Vitals optimized. Reduce OTA dependency."
    currentPage="services"
    mainEntity={mainEntity}
    breadcrumbs={breadcrumbs}
    about={about}
>
    <div class="relative w-full min-h-screen flex flex-col lg:flex-row pb-12">

            <!-- Left Content: The Pitch -->
            <div
                class="relative z-10 w-full lg:w-1/2 flex flex-col justify-center px-6 py-24 lg:py-12 lg:pl-16 lg:pr-8 xl:pl-24"
            >
                <div class="max-w-xl">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-100 border border-green-200 text-emerald-800 text-xs font-bold uppercase tracking-wide mb-6"
                    >
                        <span
                            class="w-2 h-2 rounded-full bg-primary animate-pulse"
                        ></span>
                        Google Connectivity Partner Ready
                    </div>

                    <h1
                        class="text-emerald-dark dark:text-white text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight mb-6"
                    >
                        The Direct Booking Engine <span
                            class="text-emerald-500 dark:text-primary"
                            >Built for Speed.</span
                        >
                    </h1>

                    <p
                        class="text-emerald-mid dark:text-gray-300 text-lg sm:text-xl leading-relaxed mb-6 max-w-lg"
                    >
                        Maximize direct revenue with our powerful booking
                        solution. Built on <strong>edge technology</strong> for lightning-fast
                        performance, Core Web Vitals excellence, and seamless <strong
                            >Google Hotel Center</strong
                        > integration.
                    </p>

                    <!-- Technical Compliance List for Google Reviewer -->
                    <div
                        class="mb-8 space-y-4 bg-white/50 dark:bg-black/20 p-5 rounded-xl border border-emerald-100 dark:border-emerald-900/50 backdrop-blur-sm"
                    >
                        <p
                            class="text-xs font-bold uppercase tracking-wider text-emerald-900 dark:text-emerald-400 mb-1"
                        >
                            Technical Capabilities
                        </p>

                        <div class="grid grid-cols-1 gap-3">
                            <!-- Real Time Availability -->
                            <div
                                class="flex items-start gap-3 text-sm text-emerald-800 dark:text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-primary text-[20px] shrink-0"
                                    >sync_alt</span
                                >
                                <div>
                                    <strong
                                        class="block text-emerald-900 dark:text-white"
                                        >Real-Time Availability Engine</strong
                                    >
                                    <span class="text-xs opacity-80"
                                        >Zero overbookings via instant database
                                        querying.</span
                                    >
                                </div>
                            </div>

                            <!-- Ad Ready Analytics -->
                            <div
                                class="flex items-start gap-3 text-sm text-emerald-800 dark:text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-primary text-[20px] shrink-0"
                                    >analytics</span
                                >
                                <div>
                                    <strong
                                        class="block text-emerald-900 dark:text-white"
                                        >Ad-Ready Tracking (GA4 + GTM)</strong
                                    >
                                    <span class="text-xs opacity-80"
                                        >Native support for Google Hotel Ads
                                        conversion tags.</span
                                    >
                                </div>
                            </div>

                            <!-- Payment & Security -->
                            <div
                                class="flex items-start gap-3 text-sm text-emerald-800 dark:text-gray-300"
                            >
                                <span
                                    class="material-symbols-outlined text-primary text-[20px] shrink-0"
                                    >verified_user</span
                                >
                                <div>
                                    <strong
                                        class="block text-emerald-900 dark:text-white"
                                        >PCI-DSS Compliant Payments</strong
                                    >
                                    <span class="text-xs opacity-80"
                                        >Secure DOKU Gateway integration with
                                        full TLS encryption.</span
                                    >
                                </div>
                            </div>

                            <!-- Performance -->
