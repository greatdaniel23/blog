    step2Title: "Booking Engine & PMS Integration",
    step2Desc: "We connect the agent to your reservation system so it can pull live availability, dynamic rates, and provide direct booking deep links.",
    step3Num: "03",
    step3Title: "Widget Deployment & Scenario Testing",
    step3Desc: "We install the branded luxury widget onto your website and run extensive multi-lingual test scenarios before going live.",
    step4Num: "04",
    step4Title: "Go-Live & GA4 Attribution Monitoring",
    step4Desc: "The AI agent goes live 24/7. Conversation logs and conversion metrics are continually audited for ongoing refinement.",

    // Demo Callout
    demoBannerTitle: "Want to Experience the AI Agent Live?",
    demoBannerDesc: "We have built an interactive sandbox for Samudra Luxury Villa. You can ask questions in any language and see how the agent responds and recommends rooms.",
    demoBannerBtn: "Open Interactive Demo Sandbox →",

    // Languages
