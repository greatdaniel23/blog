const tx = t[locale] || t.id;

// Unified @graph page nodes (KG-SEO v3)
const mainEntity = {
  "@type": "Service",
  "@id": `${tx.pageUrl}/#service`,
  name: tx.serviceName,
  provider: { "@id": "https://alphadigitalagency.id/#organization" },
  serviceType: "AI Chatbot for Hospitality",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Paket AI Agent Hotel",
    itemListElement: [
      { "@type": "Offer", name: "AI Agent Setup & Training", priceCurrency: "IDR" },
      { "@type": "Offer", name: "AI Agent + Booking Engine Integration", priceCurrency: "IDR" },
    ],
  },
  areaServed: { "@type": "AdministrativeArea", name: "Bali", sameAs: "https://www.wikidata.org/wiki/Q3125978" },
  description: tx.serviceDesc,
  url: tx.pageUrl
};

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Services", url: isEn ? "/en/services" : "/services" },
  { name: "AI Agent", url: tx.pageUrl }
];
const faq = tx.faq;
const about = [
  { name: "Artificial Intelligence", sameAs: "https://www.wikidata.org/wiki/Q11660" },
  { name: "Hotel", sameAs: "https://www.wikidata.org/wiki/Q27686" },
];
---

<SwissLayout
  title={isEn ? "24/7 Hotel AI Agent & Concierge Bali | Alpha Digital" : "AI Agent Hotel & Villa Bali — 24/7 Direct Booking | Alpha Digital"}
  description={tx.serviceDesc}
  currentPage="services"
  mainEntity={mainEntity}
  breadcrumbs={breadcrumbs}
  faq={faq}
  about={about}
>
  <!-- ── HERO SECTION ── -->
  <section class="relative max-w-5xl mx-auto pt-8 pb-16 px-6 md:px-12 text-center">
    <!-- Live Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-6 rounded-full bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-mono font-bold tracking-wider uppercase">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      {tx.tierLabel}
    </div>

    <!-- H1 Headline -->
    <h1 class="font-display font-extrabold text-charcoal dark:text-white leading-[1.05] tracking-tightest text-3xl sm:text-4xl md:text-5xl lg:text-6xl mb-6 max-w-4xl mx-auto">
      {tx.heroH1} <span class="text-primary block mt-1">{tx.heroH1Sub}</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-slate-600 dark:text-slate-300 text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-8">
      {tx.heroDesc}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-14">
      <a
        href={isEn ? "/en/ai-agent/demo" : "/ai-agent/demo/"}
        class="btn-swiss w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-white border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark font-bold text-sm uppercase tracking-widest hover:bg-primary-dark transition-colors"
      >
        <span class="material-symbols-outlined text-[18px]">play_circle</span>
        {tx.demoBtn}
      </a>
      <a
        href="https://wa.me/6289536870777"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-swiss w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-white dark:bg-slate-900 text-charcoal dark:text-white border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark font-bold text-sm uppercase tracking-widest hover:text-primary transition-colors"
      >
        <span class="material-symbols-outlined text-[18px]">chat</span>
        {tx.waBtn}
      </a>
    </div>

    <!-- ── INTERACTIVE CHAT MOCKUP SHOWCASE ── -->
    <div class="max-w-3xl mx-auto text-left bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark overflow-hidden">
      <!-- Mockup Header Bar -->
      <div class="bg-charcoal text-white px-5 py-3.5 flex items-center justify-between border-b-2 border-charcoal dark:border-slate-800">
        <div class="flex items-center gap-3">
          <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-primary text-white font-bold text-xs">
            AI
            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-400 border-2 border-charcoal rounded-full"></span>
          </div>
          <div>
            <div class="font-display font-bold text-xs tracking-wide uppercase">{tx.chatHeaderTitle}</div>
            <div class="text-[10px] font-mono text-emerald-400 tracking-wider uppercase">{tx.chatStatus}</div>
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
        </div>
      </div>

      <!-- Mockup Conversation Body -->
      <div class="p-6 md:p-8 space-y-6 bg-slate-50/50 dark:bg-slate-950/40">
        <!-- Guest Message Bubble -->
        <div class="flex flex-col items-end max-w-[90%] md:max-w-[80%] ml-auto">
          <span class="text-[10px] font-mono text-slate-600 dark:text-slate-400 mb-1.5">{tx.chatGuestTime}</span>
          <div class="bg-charcoal dark:bg-slate-800 text-white p-4 rounded-tl-xl rounded-tr-sm rounded-bl-xl rounded-br-xl text-sm leading-relaxed border border-slate-700">
            {tx.chatGuestMsg}
          </div>
        </div>

        <!-- AI Concierge Response Bubble -->
        <div class="flex flex-col items-start max-w-[95%] md:max-w-[88%] mr-auto">
          <span class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-bold mb-1.5 flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">bolt</span> {tx.chatAiTime}
          </span>
          <div class="bg-white dark:bg-slate-900 text-charcoal dark:text-slate-100 p-5 rounded-tr-xl rounded-tl-sm rounded-bl-xl rounded-br-xl text-sm leading-relaxed border-2 border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
            <p>{tx.chatAiMsg}</p>

            <!-- Embedded Room Card Preview -->
            <div class="bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 p-4 rounded-lg flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
              <div>
                <div class="font-bold text-sm text-charcoal dark:text-white">{tx.chatRoomTitle}</div>
                <div class="text-primary font-extrabold text-base">{tx.chatRoomRate}</div>
                <div class="text-[11px] font-mono text-slate-600 dark:text-slate-400 mt-0.5">{tx.chatRoomTag}</div>
              </div>
              <a
                href={isEn ? "/en/ai-agent/demo" : "/ai-agent/demo/"}
                class="btn-swiss inline-flex items-center gap-1 px-4 py-2 bg-primary text-white font-bold text-xs uppercase tracking-wider rounded border border-charcoal whitespace-nowrap hover:bg-primary-dark transition-colors"
              >
                {tx.chatBookBtn}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Mockup Footer Badge -->
      <div class="px-5 py-3 bg-emerald-500/10 border-t border-emerald-500/20 text-center">
        <p class="text-xs font-mono font-bold text-emerald-800 dark:text-emerald-300">
          {tx.chatFooterBadge}
        </p>
      </div>
    </div>
  </section>

  <!-- ── STATS STRIP ── -->
  <section class="max-w-5xl mx-auto px-6 md:px-12 mb-16">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
