    step1Num: "01",
    step1Title: "Ekstraksi Data & Place ID Properti",
    step1Desc: "Kami mengumpulkan detail kamar, foto, amenities, kebijakan villa, dan menghubungkan Google Place ID Anda ke basis pengetahuan agent.",
