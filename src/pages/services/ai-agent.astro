---
// SSR required — reads Astro.locals.locale set by middleware via X-Locale header
import SwissLayout from "../../components/SwissLayout.astro";
import FeaturedResources from "../../components/FeaturedResources.astro";
import Icon from "../../components/Icon.astro";
import { WA_JASA } from "../../lib/linkbio";

const locale = (Astro.locals as any).locale || 'id';
const isEn = locale === 'en';

const t = {
  id: {
    badge: "LIVE 24/7 AI HOSPITALITY CONCIERGE",
    tier: "Tier 5 — AI Agent Hospitality",
    heroH1: "Aktif 24 Jam. Terhubung Booking Engine",
    heroH1End: ".",
    heroDesc: "Asisten digital yang dilatih dari data properti Anda sendiri — menjawab pertanyaan tamu secara instan dalam bahasa mereka, menampilkan ketersediaan kamar riil, dan mengarahkan langsung ke direct booking tanpa komisi OTA.",
    demoBtn: "Coba Live Demo",
    waLabel: "Konsultasi via WhatsApp",
    ctaMail: "Minta Penawaran",
    
    // Stats Strip
    stats: [
      { value: "24/7/365", label: "Respon Tamu Aktif", sub: "Tanpa jam kantor / jeda" },
      { value: "< 1.0s", label: "Rata-rata Latensi", sub: "Jawaban instan akurat" },
      { value: "10+", label: "Bahasa Otomatis", sub: "Deteksi otomatis bahasa tamu" },
      { value: "15–30%", label: "Target Direct Booking", sub: "Shift revenue dari OTA" }
    ],

    outcome: "AI Agent kami dipasang langsung di website properti Anda — dilatih dari data kamar, tarif, Google Place ID, dan terintegrasi real-time ke booking engine untuk mengubah traffic malam hari menjadi direct booking tanpa komisi OTA.",

    // Chat Showcase
    chatTitle: "Simulasi Chat Tamu Real-Time",
    chatGuestTime: "02:14 WITA · Tamu dari Tokyo",
    chatGuestMsg: "Halo! Apakah Sunset Pool Villa masih tersedia untuk weekend depan (2 malam)? Bisa sekalian antar-jemput bandara Ngurah Rai?",
    chatAiTime: "02:14 WITA · Dijawab dalam 0.6 detik",
    chatAiMsg: "Selamat pagi! Ya, Sunset Pool Villa masih tersedia untuk tanggal 12–14 Oktober. Paket sudah mencakup sarapan gourmet harian, private infinity pool, dan complimentary private airport transfer.",
    chatRoomTitle: "Sunset Pool Villa (2 Kamar)",
    chatRoomRate: "Rp 3.850.000 / malam",
    chatRoomTag: "Garansi Harga Direct Booking Termurah",
    chatBookBtn: "Pesan Langsung (0% Komisi OTA) →",
    chatFooter: "⚡ Alur Direct Booking Terpicu · 0% Komisi OTA · Data Tercatat di GA4",

    // Margin Leakage Comparison
    compTitle: "Perbandingan Margin: Tanpa AI Agent vs. Dengan Alpha AI Agent",
    compDesc: "Tamu internasional mencari vila Bali di luar jam kerja lokal (01:00–06:00 WITA). Inilah perbedaan signifikan antara membiarkan pertanyaan menggantung vs. merespons secara instan.",
    compWithoutTitle: "❌ Tanpa AI Agent (Kebocoran Komisi OTA)",
    compWithoutItems: [
      "Pertanyaan tengah malam menggantung 6–8 jam hingga staf masuk kerja.",
      "Tamu yang ragu berpindah ke Booking.com / Agoda untuk mencari kepastian ketersediaan.",
      "Komisi 15–25% terpotong dari setiap reservasi yang masuk lewat OTA.",
      "Database & email tamu dikuasai oleh pihak ketiga (OTA)."
    ],
    compWithTitle: "✓ Dengan Alpha AI Agent (Margin Recovery)",
    compWithItems: [
      "Dijawab instan dalam 0.6 detik dalam bahasa asli tamu (Inggris, Jepang, Mandarin, dll).",
      "Ketersediaan riil & garansi harga direct booking langsung disajikan di dalam chat.",
      "0% komisi OTA — 100% pendapatan kamar masuk ke rekening properti Anda.",
      "Setiap percakapan & klik konversi tercatat penuh di Google Analytics 4."
    ],

    // Why section
    whyTitle: "Kenapa Pertanyaan Tengah Malam Sering Membocorkan Revenue?",
    whyP1: "Tamu internasional mencari vila dan hotel Bali dari berbagai zona waktu. Pertanyaan seperti ketersediaan kamar, rate 3 malam, hingga fasilitas kolam renang privat sering masuk di luar jam operasional kantor.",
    whyP2: "Jika pertanyaan tidak dijawab instan, tamu yang ragu akan berpindah ke OTA (Booking.com / Agoda). Setiap booking yang lari ke OTA berarti komisi 15–25% terpotong dari pendapatan kamar Anda.",
    whyP3: "Alpha AI Agent menangkap momen emas tersebut: merespons dalam hitungan detik dalam bahasa tamu, menyajikan harga direct terbaik, dan langsung mengarahkan tamu menyelesaikan booking di booking engine Anda.",

    // Features
    featuresTitle: "4 Arsitektur Utama Alpha AI Agent",
    features: [
      { icon: "sync_alt", title: "Koneksi Real-Time ke Booking Engine Anda", desc: "Terhubung langsung ke Cloudbeds, SiteMinder, Little Hotelier, STAAH, atau booking engine Alpha. Tamu mengecek ketersediaan riil dan langsung masuk ke checkout direct." },
      { icon: "verified_user", title: "Dilatih dari Data Riil & Google Place ID", desc: "Dilatih dari kamar, tarif, amenitas, kebijakan pembatalan, dan ulasan Place ID properti Anda sendiri — bukan template generik. Tidak ada jawaban halusinasi." },
      { icon: "language", title: "Deteksi Multibahasa Otomatis", desc: "Merespons dalam bahasa tamu secara instan — Bahasa Indonesia, Inggris, Mandarin, Jepang, Jerman, Prancis, dan lainnya tanpa perlu setup manual per bahasa." },
      { icon: "analytics", title: "Closed-Loop GA4 & Ads Attribution", desc: "Setiap percakapan dicatat ke GA4. Anda tahu persis pertanyaan apa yang paling sering diajukan dan channel iklan mana yang menghasilkan direct booking aktual." }
    ],

    // Steps
    stepsTitle: "4 Tahap Implementasi AI Agent",
    steps: [
      { step: "01", title: "Ekstraksi Data & Place ID Properti", desc: "Kami training basis pengetahuan agent dari Google Place ID, database kamar, tarif, dan kebijakan operasional properti Anda." },
      { step: "02", title: "Integrasi ke Website dan Booking Engine", desc: "Agent dipasang di website properti dan dihubungkan ke booking engine agar tamu bisa cek ketersediaan riil dari dalam chat." },
      { step: "03", title: "Uji Skenario & Go-Live", desc: "Kami uji puluhan skenario pertanyaan tamu dalam berbagai bahasa sebelum agent aktif melayani pengunjung website 24/7." },
      { step: "04", title: "Monitoring GA4 & Optimasi Rutin", desc: "Setiap log percakapan tercatat di GA4. Data digunakan untuk menyempurnakan informasi properti dan meningkatkan konversi booking." }
    ],

    // Demo Banner
    demoBannerTitle: "Coba Langsung di Sandbox Samudra Villa",
    demoBannerDesc: "Kami telah menyiapkan demo interaktif AI Agent yang berjalan pada data vila boutique Samudra Villa di Bali. Coba tanyakan ketersediaan kamar dalam bahasa apa pun.",
    demoBannerBtn: "Buka Live Demo Sandbox →",

    // Languages
    langTitle: "Bahasa yang Didukung Otomatis",
    langP: "Tamu Bali datang dari seluruh dunia. AI Agent mendeteksi bahasa tamu secara otomatis dan merespons dalam bahasa yang sama:",
    langs: ["English", "Bahasa Indonesia", "Mandarin (中文)", "Japanese (日本語)", "German (Deutsch)", "French (Français)", "Korean (한국어)", "Russian (Русский)"],

    // FAQ
    faqTitle: "Pertanyaan tentang AI Agent",
    faq: [
      { q: "Apa yang dimaksud AI Agent untuk hotel atau villa?", a: "AI Agent adalah asisten chat cerdas yang dipasang di website properti Anda. Dilatih dari data vila Anda sendiri — kebijakan, kamar, tarif, dan layanan — sehingga bisa menjawab pertanyaan tamu secara instan 24/7 dan mengarahkan ke direct booking." },
      { q: "Apakah AI Agent menggantikan staf reservasi atau front desk?", a: "Tidak. AI Agent menangani pertanyaan berulang (ketersediaan, tarif, kebijakan, rekomendasi lokal) di luar jam kerja (misal jam 1–5 subuh). Tim Anda tetap memegang interaksi personal bernilai tinggi." },
      { q: "Bagaimana cara AI Agent mengetahui ketersediaan kamar?", a: "AI Agent terintegrasi dengan booking engine (Cloudbeds, SiteMinder, STAAH, Little Hotelier, atau Alpha Booking Engine) via API ketersediaan langsung. Informasi yang disajikan selalu akurat dan up-to-date." },
      { q: "Apakah AI Agent bisa terhubung ke Google Analytics 4?", a: "Ya. Setiap interaksi dan klik booking dicatat sebagai event di GA4, sehingga Anda bisa mengevaluasi efektivitas agent dan performa traffic Google Ads." },
      { q: "Berapa lama proses setup hingga go-live?", a: "Rata-rata 5–10 hari kerja mencakup ekstraksi data, training knowledge base, integrasi sistem booking, dan uji coba skenario." }
    ],

    // Ecosystem
    ecoLabel: "Bagian dari Ekosistem Digital Marketing Hospitality",
    card1Label: "Tier 1", card1Title: "Foundation →", card1Desc: "Setup tracking GA4, GTM, dan Search Console yang presisi.",
    card2Label: "Tier 2", card2Title: "Growth →", card2Desc: "Manajemen Google Ads berorientasi ROAS & reservasi langsung.",
    card3Label: "Tier 4", card3Title: "Booking Integration →", card3Desc: "Pasang booking engine mandiri tanpa lock-in vendor.",

    // Final CTA
    finalCtaTitle: "Siap Pasang AI Agent untuk Properti Anda?",
    finalCtaDesc: "Diskusikan kebutuhan hotel atau vila Anda bersama kami. Kami siapkan demonstrasi dan opsi integrasi terbaik untuk properti Anda.",
    author: "Ditulis oleh <a href=\"/daniel-santoso/\" class=\"underline hover:text-primary\">Daniel Santoso</a> · Terakhir diperbarui: Agustus 2026",
    serviceName: "AI Agent untuk Hotel dan Vila Bali",
    serviceDesc: "AI Agent yang dilatih khusus untuk properti Anda — jawab pertanyaan tamu 24/7, rekomendasikan kamar dari booking engine, terintegrasi Google Analytics.",
    pageUrl: "https://alphadigitalagency.id/services/ai-agent"
  },
  en: {
    badge: "LIVE 24/7 AI HOSPITALITY CONCIERGE",
    tier: "Tier 5 — AI Agent Hospitality",
    heroH1: "24/7 Active. Direct Booking Integrated",
    heroH1End: ".",
    heroDesc: "A digital assistant trained on your own property data — answering guest inquiries instantly in their language, displaying real-time room availability, and routing directly to direct reservations without OTA commissions.",
    demoBtn: "Try Live Demo",
    waLabel: "Consult via WhatsApp",
    ctaMail: "Request a Proposal",
    
    // Stats Strip
    stats: [
      { value: "24/7/365", label: "Active Guest Response", sub: "Zero office hour delays" },
      { value: "< 1.0s", label: "Average Latency", sub: "Instant accurate replies" },
      { value: "10+", label: "Auto-detected Languages", sub: "Automatic guest locale matching" },
      { value: "15–30%", label: "Target Direct Shift", sub: "Reclaim OTA revenue" }
    ],

    outcome: "Our AI Agent is installed directly on your property website — trained on your rooms, rates, Google Place ID, and integrated real-time with your booking engine to convert late-night inquiries into direct bookings with zero OTA commissions.",

    // Chat Showcase
    chatTitle: "Real-Time Guest Interaction Simulation",
    chatGuestTime: "02:14 AM WITA · Guest from Tokyo",
    chatGuestMsg: "Hi! Is the 2-Bedroom Sunset Pool Villa available for next weekend (2 nights)? Can we arrange private airport pickup as well?",
    chatAiTime: "02:14 AM WITA · Answered in 0.6 seconds",
    chatAiMsg: "Good morning! Yes, our 2-Bedroom Sunset Pool Villa is available for October 12–14. It includes daily gourmet breakfast, private infinity pool, and complimentary private airport transfer.",
    chatRoomTitle: "Sunset Pool Villa (2-Bedroom)",
    chatRoomRate: "IDR 3,850,000 / night",
    chatRoomTag: "Best Direct Booking Rate Guaranteed",
    chatBookBtn: "Book Direct (0% OTA Fee) →",
    chatFooter: "⚡ Direct Booking Flow Triggered · 0% OTA Commission · Logged to GA4",

    // Margin Leakage Comparison
    compTitle: "Margin Comparison: Without AI Agent vs. With Alpha AI Agent",
    compDesc: "International travelers search for Bali villas outside local office hours (01:00–06:00 AM WITA). Here is the commercial reality between leaving questions unanswered vs. instant concierge assistance.",
    compWithoutTitle: "❌ Without AI Agent (OTA Commission Leakage)",
    compWithoutItems: [
      "Late-night inquiries wait 6–8 hours until morning front desk staff arrives.",
      "Hesitant travelers jump to Booking.com or Agoda for immediate availability.",
      "15–25% commission deducted from every room reservation booked via OTAs.",
      "Guest relationship, data, and contact info captured by the OTA platform."
    ],
    compWithTitle: "✓ With Alpha AI Agent (Direct Margin Recovery)",
    compWithItems: [
      "Answered in 0.6 seconds in the guest's native language (EN, JA, ZH, etc).",
      "Real-time availability and best direct booking rate presented immediately in chat.",
      "0% OTA commission — 100% of room revenue retained by your property.",
      "Every guest interaction and booking conversion tracked in Google Analytics 4."
    ],

    // Why section
    whyTitle: "Why Late-Night Inquiries Leak Direct Revenue",
    whyP1: "International travelers search for Bali villas and hotels across different time zones. Questions regarding availability, 3-night rates, or private pool amenities often arrive outside local office hours.",
    whyP2: "If questions are not answered instantly, hesitant guests revert to OTAs (Booking.com / Agoda). Every booking lost to an OTA means a 15–25% commission deducted from your room revenue.",
    whyP3: "Alpha AI Agent captures that critical moment: responding within seconds in the guest's language, presenting real availability, and guiding them straight to your direct booking engine.",

    // Features
    featuresTitle: "4 Core Architectural Pillars",
    features: [
      { icon: "sync_alt", title: "Real-Time Booking Engine Sync", desc: "Connects directly to Cloudbeds, SiteMinder, Little Hotelier, STAAH, or Alpha's booking engine. Guests check real availability and enter direct checkout seamlessly." },
      { icon: "verified_user", title: "Trained on Real Property Data & Place ID", desc: "Trained on your room types, rates, amenities, cancellation policies, and Place ID reviews — not generic templates. Zero hallucinated answers." },
      { icon: "language", title: "Automatic Multi-Language Recognition", desc: "Instantly responds in the guest's language — English, Indonesian, Mandarin, Japanese, German, French, and more with no manual setup needed." },
      { icon: "analytics", title: "Closed-Loop GA4 & Ads Attribution", desc: "Every conversation is logged in GA4. You see exactly what questions guests ask most and which ad campaigns drive actual direct reservations." }
    ],

    // Steps
    stepsTitle: "4-Stage Implementation Pipeline",
    steps: [
      { step: "01", title: "Property Knowledge & Place ID Extraction", desc: "We train the agent's knowledge base from your Google Place ID, room inventory, rates, and operational policies." },
      { step: "02", title: "Website & Booking Engine Integration", desc: "The agent is installed on your website and connected to your booking engine so guests can view real availability inside the chat." },
      { step: "03", title: "Scenario Testing & Go-Live", desc: "We test dozens of guest inquiry scenarios in multiple languages before the agent goes live 24/7." },
      { step: "04", title: "GA4 Monitoring & Continuous Optimization", desc: "Every conversation log is analyzed in GA4 to refine property information and continually boost booking conversion rates." }
    ],

    // Demo Banner
    demoBannerTitle: "Experience the AI Agent Live in Sandbox",
    demoBannerDesc: "We have built an interactive demo running on data from Samudra Villa Bali. Try asking questions about room availability or services in any language.",
    demoBannerBtn: "Open Live Demo Sandbox →",

    // Languages
    langTitle: "Automatically Supported Languages",
    langP: "Bali guests arrive from all over the world. The AI Agent detects the guest's language automatically and responds in the same language:",
    langs: ["English", "Bahasa Indonesia", "Mandarin (中文)", "Japanese (日本語)", "German (Deutsch)", "French (Français)", "Korean (한국어)", "Russian (Русский)"],

    // FAQ
    faqTitle: "Questions About the AI Agent",
    faq: [
      { q: "What is an AI Agent for hotels and villas?", a: "An AI Agent is an intelligent chat concierge installed on your property website. Trained on your own villa data — policies, rooms, rates, and amenities — it answers guest inquiries 24/7 and drives direct bookings." },
      { q: "Does the AI Agent replace our front desk or reservation team?", a: "No. The AI Agent handles repetitive queries and captures late-night inquiries outside working hours (e.g., 1–5 AM). Your team remains focused on high-touch guest hospitality." },
      { q: "How does the AI Agent know real room availability?", a: "The agent connects directly to your booking engine (Cloudbeds, SiteMinder, STAAH, Little Hotelier, or Alpha's engine) via live API availability feeds. Room data and rates are always accurate." },
      { q: "Can the AI Agent connect to Google Analytics 4?", a: "Yes. Every interaction and booking click is logged as a conversion event in GA4, allowing you to measure agent ROI and Google Ads effectiveness." },
      { q: "How long does setup take until go-live?", a: "Typically 5–10 business days, covering knowledge extraction, booking engine wiring, multi-lingual testing, and final quality review." }
    ],

    // Ecosystem
    ecoLabel: "Part of the Alpha Digital Direct Booking Ecosystem",
    card1Label: "Tier 1", card1Title: "Foundation →", card1Desc: "Proper tracking setup across GA4, GTM, and Search Console.",
    card2Label: "Tier 2", card2Title: "Growth →", card2Desc: "Active Google Ads management focused on direct bookings and ROAS.",
    card3Label: "Tier 4", card3Title: "Booking Integration →", card3Desc: "Platform-agnostic booking engine deployment with zero lock-in.",

    // Final CTA
    finalCtaTitle: "Ready to Deploy an AI Agent for Your Property?",
    finalCtaDesc: "Discuss your property's direct booking setup with us. We will prepare a live demonstration and integration options tailored for your villa or hotel.",
    author: "Written by <a href=\"/daniel-santoso/\" class=\"underline hover:text-primary\">Daniel Santoso</a> · Last updated: August 2026",
    serviceName: "AI Agent for Bali Hotels and Villas",
    serviceDesc: "AI Agent trained specifically for your property — answers guest questions 24/7, recommends rooms from your booking engine, integrated with Google Analytics.",
    pageUrl: "https://alphadigitalagency.id/en/services/ai-agent"
  }
};

const tx = t[locale] || t.id;

// Unified @graph page nodes (KG-SEO v3)
const mainEntity = {
  "@type": "Service",
  "@id": `${tx.pageUrl}/#service`,
  name: tx.serviceName,
  provider: { "@id": "https://alphadigitalagency.id/#organization" },
  serviceType: "AI Chatbot for Hospitality",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Paket AI Agent Hotel",
    itemListElement: [
      { "@type": "Offer", name: "AI Agent Setup & Training", priceCurrency: "IDR" },
      { "@type": "Offer", name: "AI Agent + Booking Engine Integration", priceCurrency: "IDR" },
    ],
  },
  areaServed: { "@type": "AdministrativeArea", name: "Bali", sameAs: "https://www.wikidata.org/wiki/Q3125978" },
  description: tx.serviceDesc,
  url: tx.pageUrl
};

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Services", url: isEn ? "/en/services/" : "/services/" },
  { name: "AI Agent", url: tx.pageUrl }
];
const faq = tx.faq;
const about = [
  { name: "Artificial Intelligence", sameAs: "https://www.wikidata.org/wiki/Q11660" },
  { name: "Hotel", sameAs: "https://www.wikidata.org/wiki/Q27686" },
];
---

<SwissLayout
  title={isEn ? "AI Agent for Bali Hotels & Villas | Alpha Digital" : "AI Agent Hotel & Villa Bali — 24/7 Direct Booking | Alpha Digital"}
  description={tx.serviceDesc}
  currentPage="services"
  mainEntity={mainEntity}
  breadcrumbs={breadcrumbs}
  faq={faq}
  about={about}
>
  <!-- 1. Hero Section -->
  <section class="max-w-4xl mx-auto mb-10 px-6 md:px-12 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary/10 border border-primary/30 text-primary text-xs font-mono font-bold uppercase tracking-wider mb-4">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      {tx.badge}
    </div>
    
    <h1 class="font-display font-extrabold text-charcoal dark:text-white leading-display tracking-tightest text-[2rem] sm:text-[3rem] md:text-[4rem] lg:text-[5rem] mb-6">
      {tx.heroH1}<span class="text-primary">{tx.heroH1End}</span>
    </h1>
    
    <p class="text-slate-600 dark:text-slate-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-8">
      {tx.heroDesc}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={isEn ? "/en/ai-agent/demo" : "/ai-agent/demo/"}
        class="btn-swiss inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-white border-2 border-charcoal shadow-premium font-bold text-sm uppercase tracking-widest"
      >
        <Icon name="play_circle" size={18} />
        {tx.demoBtn}
      </a>
      <a
        href={WA_JASA}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-swiss inline-flex items-center justify-center gap-2 px-8 py-4 bg-white dark:bg-slate-900 text-charcoal dark:text-white border-2 border-charcoal dark:border-white shadow-premium font-bold text-sm uppercase tracking-widest"
      >
        <Icon name="chat" size={18} />
        {tx.waLabel}
      </a>
    </div>
  </section>

  <!-- 2. Live Performance Metric Strip -->
  <section class="max-w-4xl mx-auto mb-8 px-6 md:px-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {tx.stats.map(s => (
        <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-4 md:p-6 text-center">
          <p class="font-display font-extrabold text-2xl md:text-3xl text-primary mb-1">{s.value}</p>
          <p class="font-bold text-charcoal dark:text-white text-xs uppercase tracking-wider mb-1">{s.label}</p>
          <p class="text-slate-500 dark:text-slate-400 text-[11px] font-mono">{s.sub}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Outcome statement -->
  <section class="max-w-4xl mx-auto mb-8 px-6 md:px-12">
    <div class="bg-primary/5 dark:bg-primary/10 border-l-4 border-primary p-6 md:p-8">
      <p class="text-slate-700 dark:text-slate-300 text-base md:text-lg leading-relaxed">
        {tx.outcome}
      </p>
    </div>
  </section>

  <!-- 1. Interactive Chat Showcase (Swiss Style) -->
  <section class="max-w-4xl mx-auto mb-8 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-6 md:p-8">
      <div class="flex items-center justify-between border-b-2 border-charcoal dark:border-white pb-4 mb-6">
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-primary mb-1">Live Concierge Simulation</p>
          <h2 class="font-display font-bold text-xl text-charcoal dark:text-white">{tx.chatTitle}</h2>
        </div>
        <span class="flex items-center gap-2 text-xs font-mono font-bold text-primary uppercase">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          24/7 Live
        </span>
      </div>

      <!-- Dialogue flow -->
      <div class="space-y-4 mb-6">
        <!-- Guest -->
        <div class="border-2 border-charcoal dark:border-white p-4 bg-slate-50 dark:bg-slate-800">
          <p class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">{tx.chatGuestTime}</p>
          <p class="text-sm font-medium text-charcoal dark:text-white leading-relaxed">{tx.chatGuestMsg}</p>
        </div>

        <!-- AI Agent -->
        <div class="border-2 border-primary p-4 bg-primary/5 dark:bg-primary/10">
          <p class="text-[11px] font-mono uppercase tracking-wider text-primary font-bold mb-1">{tx.chatAiTime}</p>
          <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed mb-4">{tx.chatAiMsg}</p>
          
          <div class="border border-charcoal dark:border-white p-3 bg-white dark:bg-slate-900 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
            <div>
              <p class="font-bold text-sm text-charcoal dark:text-white">{tx.chatRoomTitle}</p>
              <p class="text-xs font-bold text-primary">{tx.chatRoomRate} <span class="text-slate-500 font-normal">({tx.chatRoomTag})</span></p>
            </div>
            <a
              href={isEn ? "/en/ai-agent/demo" : "/ai-agent/demo/"}
              class="btn-swiss inline-flex items-center gap-1 px-3 py-1.5 bg-primary text-white font-bold text-xs uppercase tracking-wider border border-charcoal"
            >
              {tx.chatBookBtn}
            </a>
          </div>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-200 dark:border-slate-700 text-center">
        <p class="text-xs font-mono font-bold text-slate-600 dark:text-slate-400">{tx.chatFooter}</p>
      </div>
    </div>
  </section>

  <!-- 3. Margin Leakage Comparison -->
