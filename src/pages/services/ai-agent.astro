              <li class="flex items-start gap-2.5 text-xs md:text-sm text-slate-700 dark:text-slate-200 leading-relaxed font-medium">
                <span class="text-primary font-bold shrink-0 mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
