    card2Label: "Tier 2", card2Title: "Growth →", card2Desc: "Manajemen Google Ads berorientasi ROAS & reservasi langsung.",
    card3Label: "Tier 4", card3Title: "Booking Integration →", card3Desc: "Pasang booking engine mandiri tanpa lock-in vendor.",

    // Final CTA
