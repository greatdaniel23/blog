    // FAQ
    faqTitle: "Pertanyaan yang Sering Diajukan",
    faq: [
      { q: "Apakah AI Agent menggantikan staf front desk atau reservasi kami?", a: "Tidak. AI Agent dirancang untuk menangani beban pertanyaan berulang dan melayani tamu di luar jam kerja (misal jam 1–5 subuh). Saat jam operasional, tim Anda tetap memegang interaksi personal bernilai tinggi." },
