    // Comparison Section
    compTitle: "Why Late-Night Inquiries Leak Direct Revenue",
    compSubtitle: "International travelers search for villas across different time zones. If their questions are not answered instantly, they revert to OTAs.",
    compWithoutTitle: "Without AI Agent (Margin Leakage)",
    compWithout1: "Guest asks at 11:00 PM → Reservation team offline until 8:00 AM.",
    compWithout2: "Guest hesitates on availability & amenities → Searches on Booking.com / Agoda.",
    compWithout3: "Booking happens on OTA → 15–25% commission deducted from your room revenue.",
    compWithTitle: "With Alpha AI Agent (Margin Recovery)",
    compWith1: "Guest asks anytime → Instant answer in their native language.",
    compWith2: "Real-time room recommendations from your database & Place ID appear instantly.",
    compWith3: "Guest flows straight into your direct booking engine → 0% OTA commission, guest relationship owned.",

    // Core Capabilities
    featTitle: "4 Core Capabilities of Alpha Digital's AI Agent",
    featSubtitle: "Not a static FAQ chatbot. A dedicated digital sales concierge connected to your hotel's digital infrastructure.",
