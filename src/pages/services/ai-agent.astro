    ctaCardDesc: "Diskusikan kebutuhan properti villa atau hotel Anda bersama tim Alpha Digital. Kami siapkan roadmap integrasi khusus untuk properti Anda.",
    ctaMailBtn: "Minta Penawaran Resmi",
    author: "Ditulis oleh <a href=\"/daniel-santoso/\" class=\"underline hover:text-primary\">Daniel Santoso</a> · Terakhir diperbarui: Agustus 2026",
    serviceName: "AI Agent untuk Hotel dan Vila Bali",
    serviceDesc: "AI Agent 24/7 yang dilatih khusus dari data properti Anda — menjawab pertanyaan tamu, merekomendasikan kamar riil dari booking engine, dan meningkatkan direct booking.",
    pageUrl: "https://alphadigitalagency.id/services/ai-agent"
  },
  en: {
    tierLabel: "AI Agent for Bali Hospitality",
    heroH1: "24/7 AI Concierge for Your Hotel & Villa.",
    heroH1Sub: "Directly Connected to Your Booking Engine.",
    heroDesc: "Guests ask questions at 2 AM, your AI answers in 0.6 seconds in their native language, displays real-time room availability, and routes them directly to 0% OTA commission direct bookings.",
    demoBtn: "Try Live Demo",
    waBtn: "Consult via WhatsApp",
    
    // Stats
    stat1Val: "24/7",
    stat1Lbl: "Instant Zero-Delay Response",
    stat2Val: "< 0.8s",
    stat2Lbl: "Average Answer Latency",
    stat3Val: "10+",
    stat3Lbl: "Auto-detected Languages",
    stat4Val: "15–30%",
    stat4Lbl: "Target OTA → Direct Shift",

    // Chat Mockup
    chatHeaderTitle: "Samudra Luxury Villa — AI Concierge",
    chatStatus: "Online 24/7 · Verified Real-Time",
    chatGuestTime: "02:14 AM WITA · Guest from Tokyo",
    chatGuestMsg: "Hi! Is the 2-Bedroom Sunset Pool Villa available for next weekend (2 nights)? Can we arrange private airport pickup as well?",
    chatAiTime: "02:14 AM WITA · Answered in 0.6s",
    chatAiMsg: "Good morning! Yes, our 2-Bedroom Sunset Pool Villa is available for October 12–14. It includes daily gourmet breakfast, a private infinity pool, and complimentary private airport transfer.",
