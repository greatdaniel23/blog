      { code: "EN", name: "English", note: "Global & Regional" },
      { code: "ID", name: "Bahasa Indonesia", note: "Domestik & Lokal" },
      { code: "ZH", name: "Mandarin (中文)", note: "Mainland & Taiwan" },
      { code: "JA", name: "Japanese (日本語)", note: "Tokyo & Osaka" },
      { code: "DE", name: "Deutsch", note: "DACH Region" },
      { code: "FR", name: "Français", note: "France & Europe" },
      { code: "KO", name: "Korean (한국어)", note: "South Korea" },
      { code: "RU", name: "Russian (Русский)", note: "CIS Region" },
