      { code: "DE", name: "Deutsch", note: "DACH Region" },
      { code: "FR", name: "Français", note: "France & Europe" },
      { code: "KO", name: "Korean (한국어)", note: "South Korea" },
      { code: "RU", name: "Russian (Русский)", note: "CIS Region" },
