---
// FeaturedResources.astro — Dynamic "Featured Resources" module (KG-SEO v3
// spec 07 §4 / PRD RULE-BR-3). Static pages render the latest N blog posts
// matched by entity tag (posts.pillar_id), completing the bidirectional
// graph edge: Dynamic → Static (upward links) + Static → Dynamic (this module).
//
// Graceful empty state: when posts are unclassified (pillar_id NULL) the
// section renders nothing instead of crashing or showing stale rows.
interface Props {
	/** content_pillars.pillar_id — e.g. "google-ads", "booking-engine", "ai-agent". */
	entityTag: string;
	/** Max posts to render (spec default 3). */
	limit?: number;
}

const { entityTag, limit = 3 } = Astro.props;

// Locale-aware resource list (2026-08-18): static /en/* pages have the /en
// path prefix at build; SSR pages get X-Locale via the worker rewrite.
const pageLocale = ((Astro.locals as any).locale as string) || "id";
const hasEnPrefix =
	Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
const isEn = pageLocale === "en" || hasEnPrefix;

const { env } = Astro.locals.runtime;
let posts: { slug: string; title: string; description: string }[] = [];
if (env && env.DB) {
	const { results } = await env.DB.prepare(
		`SELECT slug, title, description FROM posts WHERE is_published = 1 AND pillar_id = ? AND slug ${isEn ? "LIKE '%-en'" : "NOT LIKE '%-en'"} ORDER BY pub_date DESC LIMIT ?`,
	)
		.bind(entityTag, limit)
		.all();
	posts = (results ?? []) as { slug: string; title: string; description: string }[];
}
---

{posts.length > 0 && (
	<section class="max-w-4xl mx-auto mb-12 px-6 md:px-12">
		<div class="border-t-2 border-charcoal dark:border-white pt-10">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2">
				<div>
					<p class="text-xs font-mono uppercase tracking-widest text-primary mb-1">
						{isEn ? "Featured Resources" : "Resource & Panduan"}
					</p>
					<h2 class="font-display font-bold text-2xl md:text-3xl text-charcoal dark:text-white">
						{isEn ? "Related Insights & Deep Dives" : "Panduan & Resource Terkait"}
					</h2>
				</div>
				<a
					href={isEn ? "/en/blog/" : "/blog/"}
					class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 hover:text-primary transition-colors flex items-center gap-1 shrink-0"
				>
					{isEn ? "All Articles →" : "Semua Artikel →"}
				</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{posts.map((post) => (
					<a
						href={`/blog/${post.slug}`}
						class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-6 card-swiss flex flex-col justify-between group block"
					>
						<div>
							<span class="inline-block text-[10px] font-mono font-bold uppercase tracking-widest text-primary bg-primary/10 px-2 py-0.5 mb-3 border border-primary/20">
								{isEn ? "Article" : "Panduan"}
							</span>
							<h3 class="font-display font-bold text-base text-charcoal dark:text-white group-hover:text-primary transition-colors mb-2 line-clamp-2 leading-snug">
								{post.title}
							</h3>
							{post.description && (
								<p class="text-xs md:text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 mb-4">
									{post.description}
								</p>
							)}
						</div>
						<div class="pt-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs font-mono font-bold text-primary group-hover:underline">
							<span>{isEn ? "Read Guide" : "Baca Panduan"}</span>
							<span>→</span>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
)}
