---
// SeoGraph — single unified @graph JSON-LD emitter (Knowledge Graph SEO v3, Phase A).
// Every page emits exactly ONE <script type="application/ld+json"> whose payload is
// an @graph array: Organization → LocalBusiness → ProfessionalService → WebSite →
// WebPage → page main entity → BreadcrumbList/FAQPage/HowTo/extra nodes.
//
// Specs: docs/knowledge-graph-seo-v3/03_ARCHITECTURE_SCHEMA.md §3 (unified @graph
// model) + 07_STATIC_PAGE_GRAPH_DETAILED_SPEC.md §3 (static node types).
// @id cross-references: page nodes point at the sitewide entities via @id refs.
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	SITE_URL,
	SITE_LOGO,
	SITE_SOCIAL,
} from "../consts";

interface Props {
	title: string;
	description: string;
	/** Absolute canonical URL, NO trailing slash. */
	url: string;
	/** Page main entity node (Service / BlogPosting / ProfessionalService / Person / Course). */
	mainEntity?: object | null;
	breadcrumbs?: { name: string; url: string }[] | null;
	faq?: { q: string; a: string }[] | null;
	howto?: { name?: string; steps: { name: string; text: string }[] } | null;
	/** Additional graph nodes (e.g. ProfilePage) — @context stripped automatically. */
	extraNodes?: object[];
	/** Entity topics for WebPage.about — Wikidata-verified QIDs only (Gap #6). */
	about?: { name: string; sameAs?: string }[] | null;
}

const {
	title,
	description,
	url,
	mainEntity,
	breadcrumbs,
	faq,
	howto,
	extraNodes = [],
	about = null,
} = Astro.props;

// No-slash form of the page URL for @id construction. The root canonical is
// "https://alphadigitalagency.id/" — appending "/#webpage" naively would emit a
// double-slash @id ("//#webpage") that mismatches the page canonical (Gap #3
// @id-consistency requirement). Every other page's canonical is already no-slash.
const urlBase = url.replace(/\/+$/, "");

// sameAs only from confirmed social URLs (D-002: LinkedIn verified; Threads not
// created yet per D-003 — never include it). No wikidata placeholders.
const sameAsList = (["linkedin"] as const)
	.map((k) => SITE_SOCIAL[k])
	.filter((u): u is string => typeof u === "string" && u.length > 0);

// Business contact data — Daniel's confirmed values 2026-08-05 (phone ratified
// canonical 0895 everywhere on 2026-08-15; schema uses E.164 form):
// address "Jl. Pulau Singkep gg starindo No.A4, Pedungan, Denpasar Selatan,
// Kota Denpasar, Bali 80223" · phone +6289536870777 · hours 9:00 am.
const BUSINESS_ADDRESS = {
	"@type": "PostalAddress",
	streetAddress: "Jl. Pulau Singkep gg starindo No.A4",
	addressLocality: "Denpasar",
	addressRegion: "Bali",
	postalCode: "80223",
	addressCountry: "ID",
};
const BUSINESS_PHONE = "+6289536870777";
// Daniel 2026-08-15: TWO contact numbers (both visible site-wide).
const BUSINESS_PHONES = ["+6289536870777", "+628814802249"];
// Business hours confirmed by Daniel: 09:00–21:00 WITA.
const BUSINESS_HOURS = {
	"@type": "OpeningHoursSpecification",
	dayOfWeek: [
		"Monday",
		"Tuesday",
		"Wednesday",
		"Thursday",
		"Friday",
		"Saturday",
		"Sunday",
	],
	opens: "09:00",
	closes: "21:00",
};

const organizationLD = {
	"@type": "Organization",
	"@id": `${SITE_URL}/#organization`,
	name: SITE_TITLE,
	url: SITE_URL,
	logo: {
		"@type": "ImageObject",
		"@id": `${SITE_URL}/#logo`,
		url: SITE_LOGO,
		caption: "Alpha Digital Agency Logo",
	},
	address: BUSINESS_ADDRESS,
	telephone: BUSINESS_PHONES,
	contactPoint: {
		"@type": "ContactPoint",
		telephone: BUSINESS_PHONE,
		email: "daniel@alphadigitalagency.id",
		contactType: "sales",
		areaServed: "ID",
		availableLanguage: ["id", "en"],
	},
	areaServed: { "@type": "Place", name: "Bali, Indonesia" },
	founder: {
		"@type": "Person",
		name: "Daniel Santoso",
		url: `${SITE_URL}/daniel-santoso`,
	},
	knowsAbout: [
		"Digital Marketing Agency Bali",
		"Digital Marketing Bali",
		"Google Ads for Hotels",
		"GA4 Analytics for Hospitality",
		"Direct Booking Strategy",
		"OTA Reduction Strategy",
		"Booking Engine Integration",
		"Bali Villa Digital Marketing",
		"Hotel Revenue Management",
		"Google Tag Manager",
		"Search Console Optimization",
	],
};
if (sameAsList.length > 0) {
	organizationLD.sameAs = sameAsList;
}

// Merged dedup LocalBusiness node (Phase A item 3): one #localbusiness per page,
// inside @graph. Data = Daniel's confirmed business record 2026-08-05 (address,
// phone, hours) + geo/priceRange from the old index block.
const localBusinessLD = {
	"@type": "LocalBusiness",
	"@id": `${SITE_URL}/#localbusiness`,
	name: SITE_TITLE,
	url: SITE_URL,
	telephone: BUSINESS_PHONES,
	email: "daniel@alphadigitalagency.id",
	address: BUSINESS_ADDRESS,
	geo: { "@type": "GeoCoordinates", latitude: -8.6705, longitude: 115.2126 },
	priceRange: "$$",
	openingHoursSpecification: BUSINESS_HOURS,
	areaServed: { "@type": "Place", name: "Bali, Indonesia" },
	parentOrganization: { "@id": `${SITE_URL}/#organization` },
};

const professionalServiceLD = {
	"@type": "ProfessionalService",
	"@id": `${SITE_URL}/#professionalservice`,
	name: SITE_TITLE,
	url: SITE_URL,
	parentOrganization: { "@id": `${SITE_URL}/#organization` },
	areaServed: { "@type": "Place", name: "Bali, Indonesia" },
	serviceType: [
		"Google Ads Management",
		"Hospitality SEO",
		"Booking Engine Integration",
		"AI Agent Implementation",
		"GA4 and Search Console Tracking",
	],
	address: BUSINESS_ADDRESS,
	geo: { "@type": "GeoCoordinates", latitude: -8.6705, longitude: 115.2126 },
	priceRange: "$$",
	telephone: BUSINESS_PHONES,
};

const websiteLD = {
	"@type": "WebSite",
	"@id": `${SITE_URL}/#website`,
	url: SITE_URL,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	publisher: { "@id": `${SITE_URL}/#organization` },
	potentialAction: {
		"@type": "SearchAction",
		target: {
			"@type": "EntryPoint",
			urlTemplate: `${SITE_URL}/?q={search_term_string}`,
		},
		"query-input": "required name=search_term_string",
	},
};

const webpageLD = {
	"@type": "WebPage",
	"@id": `${urlBase}/#webpage`,
	url,
	name: title,
	description,
	isPartOf: { "@id": `${SITE_URL}/#website` },
	...(about && about.length > 0
		? {
				about: about.map((a) =>
					a.sameAs
						? { "@type": "Thing", name: a.name, sameAs: a.sameAs }
						: { "@type": "Thing", name: a.name }
				),
			}
		: {}),
};

// Main entity: strip @context, then normalize cross-references so the node
// participates in the graph (isPartOf → #webpage, mainEntityOfPage → #webpage
// as a bare @id ref — not a nested WebPage object). Every node gets a stable
// @id (template `{{PAGE_URL}}/#main-entity`) when the page did not supply one —
// a missing @id breaks the spec's @id cross-reference requirement (Gap #5).
let mainEntityLD: object | null = null;
if (mainEntity) {
	const node = JSON.parse(JSON.stringify(mainEntity)) as Record<string, unknown>;
	delete node["@context"];
	node["@id"] = node["@id"] ?? `${urlBase}/#main-entity`;
	node.isPartOf = { "@id": `${urlBase}/#webpage` };
	node.mainEntityOfPage = { "@id": `${urlBase}/#webpage` };
	mainEntityLD = node;
}

let breadcrumbLD: object | null = null;
if (breadcrumbs && breadcrumbs.length > 0) {
	breadcrumbLD = {
		"@type": "BreadcrumbList",
		itemListElement: breadcrumbs.map((b, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: b.name,
			// Normalize to the no-trailing-slash canonical form (Gap #11) —
			// breadcrumb items must match the page canonical @id exactly.
			item: b.url === "/" ? SITE_URL : new URL(b.url.replace(/\/+$/, ""), SITE_URL).toString(),
		})),
	};
}

let faqLD: object | null = null;
if (faq && faq.length > 0) {
	faqLD = {
		"@type": "FAQPage",
		mainEntity: faq.map((f) => ({
			"@type": "Question",
			name: f.q,
			acceptedAnswer: { "@type": "Answer", text: f.a },
		})),
	};
}

let howtoLD: object | null = null;
if (howto && howto.steps && howto.steps.length > 0) {
	howtoLD = {
		"@type": "HowTo",
		...(howto.name ? { name: howto.name } : {}),
		step: howto.steps.map((s) => ({
			"@type": "HowToStep",
			name: s.name,
			text: s.text,
		})),
	};
}

const extraNodesLD = extraNodes.map((n) => {
	const node = JSON.parse(JSON.stringify(n)) as Record<string, unknown>;
	delete node["@context"];
	return node;
});

const graph = [
	organizationLD,
	localBusinessLD,
	professionalServiceLD,
	websiteLD,
	webpageLD,
	mainEntityLD,
	breadcrumbLD,
	faqLD,
	howtoLD,
	...extraNodesLD,
].filter(Boolean);

const graphLD = {
	"@context": "https://schema.org",
	"@graph": graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(graphLD)} />
