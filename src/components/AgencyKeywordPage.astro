      comparisonRows: [
        { aspect: 'Bidding Optimization', general: 'Optimizes for vanity clicks or generic form leads', alpha: 'Optimizes for verified reservation transaction value and ROAS' },
        { aspect: 'Conversion Tracking', general: 'Stops at generic "Book" button clicks', alpha: 'Full transaction value tracking through payment gateway completion' },
