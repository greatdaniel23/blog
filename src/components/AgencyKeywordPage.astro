const current = pageData[variant][isEn ? 'en' : 'id'];
const pageUrl = `${SITE_URL}${prefix}/${current.canonicalSlug}/`;

const mainEntity = {
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  "name": current.title,
  "provider": {
    "@id": "https://alphadigitalagency.id/#organization"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "Bali",
    "sameAs": "https://www.wikidata.org/wiki/Q3125978"
  },
  "description": current.h2,
  "serviceType": current.eyebrow,
  "url": pageUrl
};

const breadcrumbs = [
  { "name": "Home", "url": isEn ? "/en/" : "/" },
  { "name": current.eyebrow, "url": pageUrl }
];
---

<SwissLayout
  title={current.title}
  description={current.h2}
  currentPage={variant}
  mainEntity={mainEntity}
  faq={current.faq}
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="max-w-4xl mx-auto pt-8 pb-14 px-6 md:px-12 text-center">
    <div class="inline-block bg-primary/10 border border-primary/30 text-primary px-3.5 py-1 text-xs font-bold uppercase tracking-widest mb-6">
      {current.eyebrow}
    </div>
    <h1 class="font-display font-extrabold text-charcoal dark:text-white text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-[1.1] tracking-tightest mb-6">
      {current.h1}
    </h1>
    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 font-medium max-w-2xl mx-auto leading-relaxed mb-8">
      {current.h2}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href={WA_JASA}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-white border-2 border-charcoal dark:border-white font-bold text-sm uppercase tracking-wider shadow-premium dark:shadow-premium-dark hover:translate-x-[2px] hover:translate-y-[1px] hover:shadow-premium-hover transition-all"
      >
        <Icon name="whatsapp" size={20} />
        {current.ctaButton}
      </a>
      <a
        href={isEn ? "/en/about/" : "/about/"}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-white dark:bg-slate-900 text-charcoal dark:text-white border-2 border-charcoal dark:border-white font-bold text-sm uppercase tracking-wider shadow-premium dark:shadow-premium-dark hover:bg-slate-50 dark:hover:bg-slate-800 transition-all"
      >
        {isEn ? "About Daniel & Alpha" : "Tentang Daniel & Alpha"}
      </a>
    </div>
  </section>

  <!-- Deliverables Matrix -->
  <section class="max-w-4xl mx-auto pb-16 px-6 md:px-12">
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-12">
      <div class="text-xs uppercase tracking-widest text-slate-500 font-bold mb-2">Scope of Work</div>
      <h2 class="font-display font-extrabold text-2xl md:text-3xl text-charcoal dark:text-white mb-8">
        {current.deliverablesH2}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {current.deliverables.map((item) => (
          <div class="border border-slate-200 dark:border-slate-800 p-6 bg-slate-50/50 dark:bg-slate-800/50 flex flex-col justify-between">
            <div>
              <h3 class="font-display font-bold text-lg text-charcoal dark:text-white mb-2">{item.title}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-12 overflow-x-auto">
      <div class="text-xs uppercase tracking-widest text-slate-500 font-bold mb-2">Comparison Matrix</div>
      <h2 class="font-display font-extrabold text-2xl md:text-3xl text-charcoal dark:text-white mb-6">
        {current.comparisonH2}
      </h2>
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="border-b-2 border-charcoal dark:border-white text-xs uppercase tracking-wider">
            <th class="py-3 px-4 font-bold">Aspek</th>
            <th class="py-3 px-4 font-bold text-slate-500">{isEn ? 'General Agencies' : 'Agency Umum / Non-Spesialis'}</th>
            <th class="py-3 px-4 font-bold text-primary">Alpha Digital Agency</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
          {current.comparisonRows.map((row) => (
            <tr>
              <td class="py-4 px-4 font-bold text-charcoal dark:text-white align-top">{row.aspect}</td>
              <td class="py-4 px-4 text-slate-600 dark:text-slate-400 align-top">{row.general}</td>
              <td class="py-4 px-4 font-semibold text-charcoal dark:text-white bg-primary/5 align-top">{row.alpha}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Cross Navigation of 5 Money Pages -->
    <div class="border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 p-6 mb-12">
      <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">{isEn ? 'Explore Alpha Capabilities:' : 'Pelajari Layanan Alpha Lainnya:'}</div>
      <div class="flex flex-wrap gap-4 text-sm font-bold">
        {variant !== 'marketing' && (
          <a href={`${prefix}/marketing-agency-bali/`} class="text-primary hover:underline">
            &rarr; Marketing Agency Bali
          </a>
        )}
        {variant !== 'digital-marketing' && (
          <a href={`${prefix}/digital-marketing-agency-bali/`} class="text-primary hover:underline">
            &rarr; Digital Marketing Agency Bali
          </a>
        )}
        {variant !== 'digital-agency' && (
          <a href={`${prefix}/digital-agency-bali/`} class="text-primary hover:underline">
            &rarr; Digital Agency Bali
          </a>
        )}
        {variant !== 'digital-marketing-bali' && (
          <a href={`${prefix}/digital-marketing-bali/`} class="text-primary hover:underline">
            &rarr; Digital Marketing Bali
          </a>
        )}
        {variant !== 'google-ads-bali' && (
          <a href={`${prefix}/google-ads-bali/`} class="text-primary hover:underline">
            &rarr; Google Ads Bali
          </a>
        )}
        <a href={isEn ? "/en/services/booking-engine/" : "/services/booking-engine/"} class="text-slate-600 dark:text-slate-400 hover:text-primary">
          &rarr; Booking Engine Villa
        </a>
        <a href={isEn ? "/en/services/ai-agent/" : "/services/ai-agent/"} class="text-slate-600 dark:text-slate-400 hover:text-primary">
          &rarr; AI Agent Hospitality
        </a>
      </div>
    </div>

    <!-- FAQ Accordion -->
    <div class="bg-white dark:bg-slate-900 border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 mb-12">
      <h2 class="font-display font-extrabold text-2xl md:text-3xl text-charcoal dark:text-white mb-6">
        {current.faqTitle}
      </h2>
      <div class="space-y-4">
        {current.faq.map((item) => (
          <details class="border border-slate-200 dark:border-slate-800 p-5 group bg-slate-50/30 dark:bg-slate-800/30">
            <summary class="font-bold text-charcoal dark:text-white cursor-pointer list-none flex justify-between items-center gap-4">
              <span>{item.q}</span>
              <span class="text-primary font-mono text-xl group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </div>

    <!-- Bottom CTA Card -->
    <div class="bg-primary text-white border-2 border-charcoal dark:border-white shadow-premium dark:shadow-premium-dark p-8 md:p-12 text-center">
      <h2 class="font-display font-extrabold text-2xl md:text-4xl tracking-tight mb-4">
        {current.ctaTitle}
      </h2>
      <p class="text-sm md:text-base text-white/90 max-w-xl mx-auto leading-relaxed mb-8">
        {current.ctaDesc}
      </p>
      <a
        href={WA_JASA}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-charcoal border-2 border-charcoal font-bold text-sm uppercase tracking-wider shadow-sm hover:bg-slate-100 transition-all"
      >
        <Icon name="whatsapp" size={20} />
        {current.ctaButton}
      </a>
    </div>
  </section>
</SwissLayout>
